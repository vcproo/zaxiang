---
import { u } from '../url';
interface Props {
  variant?: 'hero' | 'about';
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
}
const { variant = 'hero', src, alt, width, height, caption } = Astro.props;
/** 瞳孔锚点（相对整图百分比）——按裁切后的立绘实测 */
const eyes = variant === 'hero'
  ? { lx: 42.2, ly: 45.5, rx: 51.0, ry: 44.7, ew: 5.5, eh: 3.6 }
  : { lx: 35.6, ly: 51.7, rx: 66.8, ry: 51.7, ew: 9.0, eh: 5.6 };
---
<figure class:list={['ipfig', `ipfig--${variant}`]} data-ipfig data-eyes={JSON.stringify(eyes)}>
  <div class="ipfig-stage">
    <img class="ipfig-img" src={u(src)} alt={alt} width={width} height={height} decoding="async" draggable="false"/>
    <div class="ipfig-eyes" aria-hidden="true">
      <span class="eye" style={`left:${eyes.lx}%;top:${eyes.ly}%;width:${eyes.ew}%;height:${eyes.eh}%`}><i class="pupil"></i></span>
      <span class="eye" style={`left:${eyes.rx}%;top:${eyes.ry}%;width:${eyes.ew}%;height:${eyes.eh}%`}><i class="pupil"></i></span>
      <span class="lids"></span>
    </div>
  </div>
  {caption && <figcaption class="ipfig-cap mono">{caption}</figcaption>}
</figure>

<style>
.ipfig{margin:0;text-align:center}
.ipfig-stage{position:relative;display:inline-block;max-width:100%;line-height:0;
  /* 透明边距已在 PNG 内；再用 contain 防容器裁切 */
  overflow:visible}
.ipfig-img{display:block;width:100%;height:auto;max-width:100%;object-fit:contain;
  filter:drop-shadow(0 14px 24px rgba(23,21,15,.12));user-select:none;-webkit-user-drag:none}
.ipfig--hero .ipfig-img{width:min(100%,360px);filter:drop-shadow(0 18px 28px rgba(23,21,15,.14))}
.ipfig--about .ipfig-img{width:100%}
.ipfig-cap{line-height:1.4;margin-top:12px;font-size:11px;letter-spacing:.12em;color:var(--ink-3)}
.ipfig-eyes{position:absolute;inset:0;pointer-events:none}
.eye{position:absolute;transform:translate(-50%,-50%);border-radius:50%;
  overflow:hidden;background:transparent}
.pupil{position:absolute;left:50%;top:52%;width:42%;height:55%;border-radius:50%;
  background:rgba(20,40,34,.72);transform:translate(-50%,-50%);
  box-shadow:inset 0 -1px 0 rgba(255,255,255,.25); will-change:transform;
  transition:transform .08s linear}
.lids{position:absolute;inset:0;background:transparent;opacity:0;
  /* lids are drawn as two dark ellipses via box-shadow? use mask instead — simpler: scale eyes */
  pointer-events:none}
.ipfig.is-blink .eye{transform:translate(-50%,-50%) scaleY(0.08); transform-origin:center 40%}
.ipfig.is-blink .pupil{opacity:0}
@media(prefers-reduced-motion:reduce){
  .pupil{transition:none}
  .ipfig.is-blink .eye{transform:translate(-50%,-50%)}
}
</style>

<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
document.querySelectorAll<HTMLElement>('[data-ipfig]').forEach(root => {
  const eyes = root.querySelectorAll<HTMLElement>('.eye');
  const pupils = root.querySelectorAll<HTMLElement>('.pupil');
  const stage = root.querySelector('.ipfig-stage') as HTMLElement;
  let mx = 0, my = 0, cx = 0, cy = 0, raf = 0, blinkT = 0;

  function aim() {
    raf = 0;
    const max = 22; // % within eye
    pupils.forEach((p, i) => {
      const er = eyes[i].getBoundingClientRect();
      const ex = er.left + er.width / 2, ey = er.top + er.height / 2;
      let dx = (mx - ex) / (window.innerWidth * 0.35);
      let dy = (my - ey) / (window.innerHeight * 0.35);
      dx = Math.max(-1, Math.min(1, dx));
      dy = Math.max(-1, Math.min(1, dy));
      p.style.transform = `translate(calc(-50% + ${dx * max}%), calc(-50% + ${dy * max}%))`;
    });
  }

  if (!reduce) {
    window.addEventListener('pointermove', e => {
      mx = e.clientX; my = e.clientY;
      if (!raf) raf = requestAnimationFrame(aim);
    }, { passive: true });
    // idle drift toward center of stage occasionally reset
    const loop = (t: number) => {
      if (!blinkT) blinkT = t + 2400 + Math.random() * 3200;
      if (t >= blinkT) {
        root.classList.add('is-blink');
        setTimeout(() => root.classList.remove('is-blink'), 120 + Math.random() * 40);
        blinkT = t + 2800 + Math.random() * 5000;
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
});
</script>
