---
import { u } from '../url';
interface Props {
  variant?: 'hero' | 'about';
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
}
const { variant = 'hero', src, alt, width, height, caption } = Astro.props;
---
<figure class:list={['ipfig', `ipfig--${variant}`]} data-ipfig>
  <div class="ipfig-stage">
    <img class="ipfig-img" src={u(src)} alt={alt} width={width} height={variant === 'about' ? 497 : height} decoding="async" draggable="false"/>
  </div>
  {caption && <figcaption class="ipfig-cap mono">{caption}</figcaption>}
</figure>

<style>
.ipfig{margin:0;text-align:center}
.ipfig-stage{position:relative;display:inline-block;max-width:100%;line-height:0;filter:drop-shadow(0 14px 24px rgba(23,21,15,.12))}
.ipfig-img{display:block;width:100%;height:auto;max-width:100%;object-fit:contain;
  user-select:none;-webkit-user-drag:none}
.ipfig--hero .ipfig-img{width:min(100%,380px);}
.ipfig--about .ipfig-img{width:100%}
.ipfig-cap{line-height:1.4;margin-top:12px;font-size:11px;letter-spacing:.12em;color:var(--ink-3)}
</style>
