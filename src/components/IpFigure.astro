---
import { u } from '../url';
interface Props {
  variant?: 'hero' | 'about';
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
}
const { variant = 'hero', src, alt, width, height, caption } = Astro.props;
---
<!-- 角色站在奶白光圈里：深色背景上保证轮廓清晰（IP 规范 §9 留白与背景） -->
<figure class:list={['stage', `stage--${variant}`]}>
  <div class="stage-disc" aria-hidden="true">
    <svg class="stage-ring" viewBox="0 0 100 100"><circle cx="50" cy="50" r="49"/></svg>
  </div>
  <img class="stage-img" src={u(src)} alt={alt} width={width} height={height} draggable="false"/>
  {caption && <figcaption class="stage-cap mono">{caption}</figcaption>}
</figure>

<style>
.stage{position:relative;margin:0;width:100%;aspect-ratio:1}
.stage-disc{position:absolute;inset:6%;border-radius:50%;
  background:radial-gradient(circle at 50% 38%,#FBF6EC 0%,#F3EBDD 46%,#E4D8C4 100%);
  box-shadow:0 0 0 1px rgba(243,235,221,.25),0 40px 120px -30px rgba(199,239,220,.35),0 30px 80px -20px rgba(0,0,0,.6)}
.stage-ring{position:absolute;inset:-5.5%;width:111%;height:111%;overflow:visible;animation:ring 80s linear infinite}
.stage-ring circle{fill:none;stroke:rgba(199,239,220,.5);stroke-width:.4;stroke-dasharray:.6 2.4;stroke-linecap:round}
@keyframes ring{to{transform:rotate(360deg)}}
.stage-img{position:absolute;display:block;height:auto;user-select:none;-webkit-user-drag:none;filter:drop-shadow(0 18px 22px rgba(39,35,45,.18))}
.stage--hero .stage-img{width:64%;left:18%;top:3%}
.stage--about .stage-img{width:70%;left:15%;top:8%}
.stage-cap{position:absolute;left:50%;bottom:-3%;translate:-50% 0;white-space:nowrap;font-size:10.5px;letter-spacing:.2em;color:var(--fg-3)}
</style>
