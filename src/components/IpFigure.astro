---
import { u } from '../url';
interface Props {
  variant?: 'hero' | 'about';
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
}
const { variant = 'hero', src, alt, width, height, caption } = Astro.props;
/**
 * Blink-only lids (no pupils, no pointer follow).
 * Anchors are % of the full figure bitmap (pad included).
 * Lid = face ink overlay that scaleY-closes over each mint main eye;
 * sec = soft ink veil that dims the six spider dots during blink.
 */
const cfg = variant === 'hero'
  ? {
      eyes: [
        { x: 47.4, y: 42.2, w: 14.0, h: 8.5 },
        { x: 79.3, y: 46.3, w: 14.0, h: 8.3 },
      ],
      sec: { x: 64.6, y: 35.3, w: 37, h: 10 },
    }
  : {
      eyes: [
        { x: 35.1, y: 46.5, w: 15.0, h: 9.0 },
        { x: 68.7, y: 46.5, w: 15.0, h: 9.0 },
      ],
      sec: { x: 51.7, y: 36.4, w: 38, h: 9 },
    };
---
<figure class:list={['ipfig', `ipfig--${variant}`]} data-ipfig data-blink>
  <div class="ipfig-stage">
    <img class="ipfig-img" src={u(src)} alt={alt} width={width} height={height} decoding="async" draggable="false"/>
    <div class="ipfig-fx" aria-hidden="true">
      {cfg.eyes.map(e => (
        <span class="lid" style={`left:${e.x}%;top:${e.y}%;width:${e.w}%;height:${e.h}%`}></span>
      ))}
      <span class="sec" style={`left:${cfg.sec.x}%;top:${cfg.sec.y}%;width:${cfg.sec.w}%;height:${cfg.sec.h}%`}></span>
    </div>
  </div>
  {caption && <figcaption class="ipfig-cap mono">{caption}</figcaption>}
</figure>

<style>
.ipfig{margin:0;text-align:center}
.ipfig-stage{position:relative;display:inline-block;max-width:100%;line-height:0;overflow:visible}
.ipfig-img{display:block;width:100%;height:auto;max-width:100%;object-fit:contain;
  filter:drop-shadow(0 14px 24px rgba(23,21,15,.12));user-select:none;-webkit-user-drag:none}
.ipfig--hero .ipfig-img{width:min(100%,360px);filter:drop-shadow(0 16px 26px rgba(23,21,15,.13))}
.ipfig--about .ipfig-img{width:100%}
.ipfig-cap{line-height:1.4;margin-top:12px;font-size:11px;letter-spacing:.12em;color:var(--ink-3)}
.ipfig-fx{position:absolute;inset:0;pointer-events:none}
.lid{
  position:absolute;transform:translate(-50%,-50%) scaleY(0.04);
  transform-origin:50% 12%;
  border-radius:50% 50% 48% 48%;
  background:#1B181F;
  opacity:0;
  transition: transform .1s steps(2,end), opacity .06s linear;
}
.sec{
  position:absolute;transform:translate(-50%,-50%);
  border-radius:45%;
  background:transparent;
  opacity:0;
  transition: opacity .1s linear;
}
.ipfig.is-blink .lid{
  transform:translate(-50%,-50%) scaleY(1);
  opacity:1;
  transition: transform .08s cubic-bezier(.2,.8,.2,1), opacity .05s linear;
}
.ipfig.is-blink .sec{
  opacity:1;
  background:rgba(27,24,31,.58);
  transition: opacity .08s linear;
}
@media (prefers-reduced-motion: reduce){
  .lid,.sec{transition:none !important}
  .ipfig.is-blink .lid{transform:translate(-50%,-50%) scaleY(0.04);opacity:0}
  .ipfig.is-blink .sec{opacity:0}
}
</style>

<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (!reduce) {
  document.querySelectorAll<HTMLElement>('[data-blink]').forEach(root => {
    let next = 0;
    const tick = (t: number) => {
      if (!next) next = t + 2200 + Math.random() * 2800;
      if (t >= next) {
        root.classList.add('is-blink');
        const hold = 90 + Math.random() * 50;
        setTimeout(() => root.classList.remove('is-blink'), hold);
        if (Math.random() < 0.22) {
          setTimeout(() => {
            root.classList.add('is-blink');
            setTimeout(() => root.classList.remove('is-blink'), 80);
          }, hold + 120);
          next = t + 4500 + Math.random() * 4000;
        } else {
          next = t + 2600 + Math.random() * 4200;
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
}
</script>
