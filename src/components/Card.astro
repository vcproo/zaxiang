---
import { u } from '../url';
const { t, idx } = Astro.props;
const d = t.data.date.toISOString().slice(0, 10);
const no = t.data.order ?? idx;
---
<a class="row spot" href={u(`/tutorials/${t.id}/`)} data-tags={t.data.tags.join(',')} data-text={(t.data.title + t.data.description + t.data.tags.join(' ')).toLowerCase()}>
  <span class="no mono" aria-hidden="true">{no !== undefined ? String(no).padStart(2, '0') : '··'}</span>
  <span class="main">
    {t.data.kicker && <span class="kick mono">{t.data.kicker}</span>}
    <strong>{t.data.title}</strong>
    <span class="desc">{t.data.description}</span>
  </span>
  <span class="meta mono"><span class="lv">{t.data.level}</span><span>{d}</span></span>
  <span class="arrow" aria-hidden="true">→</span>
</a>
<style>
.row{position:relative;isolation:isolate;display:grid;grid-template-columns:88px minmax(0,1fr) 120px 40px;gap:24px;align-items:center;
  padding:30px 20px;border-top:1px solid var(--line);text-decoration:none;border-radius:4px;transition:background .3s}
.row::before{content:"";position:absolute;left:0;top:30px;bottom:30px;width:2px;background:var(--mint);transform:scaleY(0);transition:transform .45s var(--ease)}
.row:hover{background:rgba(243,235,221,.025)} .row:hover::before{transform:scaleY(1)}
.no{font-size:44px;font-weight:600;line-height:1;color:transparent;-webkit-text-stroke:1px var(--fg-3);transition:color .35s,-webkit-text-stroke-color .35s}
.row:hover .no{color:var(--mint);-webkit-text-stroke-color:var(--mint)}
.main{display:flex;flex-direction:column;gap:8px;min-width:0}
.kick{font-size:11.5px;letter-spacing:.16em;color:var(--mint);opacity:.85}
strong{font-size:22px;font-weight:700;line-height:1.4;letter-spacing:-.01em}
.desc{color:var(--fg-2);font-size:15.5px;line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.meta{display:grid;gap:6px;justify-items:end;font-size:12px;color:var(--fg-3)}
.lv{padding:3px 9px;border:1px solid var(--line-2);border-radius:999px;color:var(--fg-2)}
.arrow{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;border:1px solid var(--line-2);font-size:16px;transition:all .45s var(--spring)}
.row:hover .arrow{background:var(--mint);border-color:var(--mint);color:var(--ink);transform:rotate(-45deg)}
@media(max-width:860px){.row{grid-template-columns:56px minmax(0,1fr) 36px;gap:16px;padding:24px 8px}.meta{display:none}.no{font-size:30px}.arrow{width:36px;height:36px}}
@media(max-width:560px){.row{grid-template-columns:minmax(0,1fr) 32px}.no{display:none}strong{font-size:19px}.arrow{width:32px;height:32px;font-size:14px}}
</style>
