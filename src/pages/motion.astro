---
import { u } from '../url';
import Base from '../layouts/Base.astro';
const styleSrc = u('/style-motion/styles.html') + '?embed=1';
const motionSrc = u('/style-motion/motion.html') + '?embed=1';
---
<Base title="动效档案" description="17 种画风和 34 个动效，用来对齐叫法、挑选气质、复制给 AI。">
  <section class="wrap motion-page">
    <header class="intro">
      <p class="mono eyebrow">MOTION ARCHIVE / 动效档案</p>
      <h1>画风怎么叫，动效怎么动。</h1>
      <p class="lead">做片子前先把叫法对齐。下面是 17 种能稳定做出来的画风，和 34 个拆到最小单元的动效。看中哪个，把那句话交给你的 AI。</p>
      <div class="formula" aria-label="一句话说清一个镜头">
        <div><code class="mono">画风</code><b>看起来像什么</b><span>暗场网格、蓝图、瑞士海报……</span></div>
        <div><code class="mono">镜头</code><b>这镜完成什么任务</b><span>讲清关系、拆开零件、砸一个数字</span></div>
        <div><code class="mono">动效</code><b>东西怎么动</b><span>砸字、描边生长、容器变形接力</span></div>
      </div>
    </header>

    <div class="archive" data-archive>
      <div class="tabs" role="tablist" aria-label="档案分类">
        <button type="button" class="sd-tag on" role="tab" id="tab-style" aria-controls="panel-style" aria-selected="true" data-tab="style">画风导览 · 17</button>
        <button type="button" class="sd-tag" role="tab" id="tab-motion" aria-controls="panel-motion" aria-selected="false" data-tab="motion">动效词典 · 34</button>
      </div>
      <p class="hint" data-hint-style>点开色卡，复制「对 AI 这么说」。样张只展示气质，你的内容细节会不一样。</p>
      <p class="hint" data-hint-motion hidden>放慢到 ¼× 看帧，拖滑杆改手感，再复制那一行调用码。也可以说「像 #10，但再慢一点」。</p>
      <figure class="board">
        <figcaption class="mono"><span data-cap>EVIDENCE · STYLE</span><span>LIVE DEMO</span></figcaption>
        <div class="board-view">
          <iframe
            id="panel-style"
            role="tabpanel"
            aria-labelledby="tab-style"
            title="画风导览"
            src={styleSrc}
            allow="clipboard-write"
          ></iframe>
          <iframe
            id="panel-motion"
            role="tabpanel"
            aria-labelledby="tab-motion"
            title="动效词典"
            data-src={motionSrc}
            allow="clipboard-write"
            hidden
          ></iframe>
        </div>
      </figure>
    </div>
    <p class="note">舞台里的画面由代码实时绘制。开启系统「减少动态效果」时，画风样张会停在代表性的一帧。</p>
  </section>
</Base>
<style is:global>
.motion-page{padding-top:48px;padding-bottom:8px}
.motion-page .eyebrow{font-size:12px;color:var(--ink-3);letter-spacing:.12em;margin:0 0 12px}
.motion-page h1{font-family:var(--serif);font-size:clamp(32px,5vw,52px);line-height:1.25;margin:0 0 16px}
.motion-page .lead{color:var(--ink-2);max-width:40em;margin:0 0 28px;font-size:18px}
.motion-page .formula{margin:0 0 36px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1.5px solid var(--ink);border-radius:var(--r);background:#fbf9f4;box-shadow:4px 4px 0 var(--pin);overflow:hidden}
.motion-page .formula > div{padding:16px 18px;display:grid;gap:4px;min-width:0}
.motion-page .formula > div + div{border-left:1px solid var(--line)}
.motion-page .formula code{font-size:11px;color:var(--ink-3);letter-spacing:.08em}
.motion-page .formula b{font-family:var(--serif);font-size:20px}
.motion-page .formula span{font-size:13px;color:var(--ink-2)}
.motion-page .tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.motion-page .tabs button{font:inherit;cursor:pointer}
.motion-page .hint{font-size:14px;color:var(--ink-3);margin:0 0 14px}
.motion-page .board{margin:0;background:#fbf9f4;border:1.5px solid var(--ink);border-radius:var(--r);box-shadow:4px 4px 0 var(--pin);overflow:hidden}
.motion-page .board figcaption{display:flex;justify-content:space-between;gap:12px;padding:8px 14px;border-bottom:1px solid var(--line);background:var(--paper-2);font-size:11px;letter-spacing:.12em;color:var(--ink-3)}
.motion-page .board-view{height:min(78vh,900px);min-height:560px;background:var(--paper)}
.motion-page .board iframe{width:100%;height:100%;border:0;display:block;background:var(--paper)}
.motion-page .board iframe[hidden]{display:none}
.motion-page .note{font-size:13px;color:var(--ink-3);margin-top:18px}
@media(max-width:720px){
  .motion-page{padding-top:28px}
  .motion-page .formula{grid-template-columns:1fr}
  .motion-page .formula > div + div{border-left:0;border-top:1px solid var(--line)}
  .motion-page .board-view{height:70vh;min-height:480px}
}
</style>
<script>
const root = document.querySelector<HTMLElement>('[data-archive]')!;
const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
const styleFrame = document.getElementById('panel-style') as HTMLIFrameElement;
const motionFrame = document.getElementById('panel-motion') as HTMLIFrameElement;
const hintStyle = root.querySelector<HTMLElement>('[data-hint-style]')!;
const hintMotion = root.querySelector<HTMLElement>('[data-hint-motion]')!;
const cap = root.querySelector<HTMLElement>('[data-cap]')!;

function show(name: 'style' | 'motion') {
  const onMotion = name === 'motion';
  if (onMotion && !motionFrame.src) motionFrame.src = motionFrame.dataset.src || '';
  styleFrame.hidden = onMotion;
  motionFrame.hidden = !onMotion;
  hintStyle.hidden = onMotion;
  hintMotion.hidden = !onMotion;
  cap.textContent = onMotion ? 'EVIDENCE · MOTION' : 'EVIDENCE · STYLE';
  buttons.forEach(btn => {
    const selected = btn.dataset.tab === name;
    btn.setAttribute('aria-selected', String(selected));
    btn.classList.toggle('on', selected);
  });
  const hash = onMotion ? '#motion' : '#style';
  if (location.hash !== hash) history.replaceState(null, '', hash);
}

buttons.forEach(btn => btn.addEventListener('click', () => show(btn.dataset.tab === 'motion' ? 'motion' : 'style')));
show(location.hash === '#motion' ? 'motion' : 'style');
addEventListener('hashchange', () => show(location.hash === '#motion' ? 'motion' : 'style'));
</script>
