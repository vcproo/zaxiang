---
import { u } from '../url';
import Base from '../layouts/Base.astro';
import '../styles/style-motion.css';
import fontwarm from '../data/style-fontwarm.html?raw';
import { ui, langFromPath } from '../i18n';
const lang = ((Astro.props.lang === 'en' || Astro.props.lang === 'zh') ? Astro.props.lang : langFromPath(Astro.url.pathname)) as 'zh' | 'en';
const t = ui[lang];
---
<Base lang={lang} title={t.motionTitle} description={t.motionDesc}>
  <link rel="stylesheet" href={u('/style-motion/fonts/fonts.css')}/>
  <section class="wrap motion-page page">
    <header class="page-head">
      <p class="eyebrow rise">{t.motionEyebrow}</p>
      <h1 class="rise" style="animation-delay:.06s">{t.motionH1a}<br/>{t.motionH1b}</h1>
      <p class="intro rise" style="animation-delay:.12s">{t.motionIntro}</p>
    </header>
    <div class="formula rise" style="animation-delay:.18s" aria-label={t.motionFormula}>
      <div><code class="mono">01 · {lang === 'zh' ? '画风' : 'Look'}</code><b>{t.motionF1}</b><span>{t.motionF1s}</span></div>
      <div><code class="mono">02 · {lang === 'zh' ? '镜头' : 'Shot'}</code><b>{t.motionF2}</b><span>{t.motionF2s}</span></div>
      <div><code class="mono">03 · {lang === 'zh' ? '动效' : 'Motion'}</code><b>{t.motionF3}</b><span>{t.motionF3s}</span></div>
      <p class="say"><span class="mono">{t.motionSay}</span><span set:html={lang === 'zh' ? '这镜用<mark>蓝图</mark>，拆开<mark>一个零件</mark>，入场用<mark>描边生长</mark>。' : 'This shot uses a <mark>blueprint</mark>, explodes <mark>one part</mark>, and enters with a <mark>stroke draw</mark>.'}></span></p>
    </div>

    <div class="tabs" role="tablist" aria-label={t.motionTabs}>
      <button type="button" class="seg-btn on" role="tab" id="tab-style" aria-controls="panel-style" aria-selected="true" data-tab="style">{t.motionTabStyle}</button>
      <button type="button" class="seg-btn" role="tab" id="tab-dict" aria-controls="panel-dict" aria-selected="false" data-tab="dict">{t.motionTabDict}</button>
    </div>

    <!-- 画风导览：原 styles.html，脚本在 public/style-motion/styles.js -->
    <div class="panel" id="panel-style" role="tabpanel" aria-labelledby="tab-style">
      <div class="panel-intro">
        <p>{t.motionStyleP}<em>{t.motionStyleEm}</em></p>
        <p class="aside">{t.motionStyleAside}</p>
      </div>
      <div class="sm-style">
        <nav class="filters" id="filters" aria-label={t.motionMoodLabel}><span class="lab">{t.motionMood}</span></nav>
        <section id="sec-live"><div class="sec-head"><h2>{t.motionLive}</h2><p>{t.motionLiveP}</p></div><div class="grid" id="grid-live"></div></section>
        <section id="sec-new"><div class="sec-head"><h2>{t.motionNew}</h2><p>{t.motionNewP}</p></div><div class="grid" id="grid-new"></div></section>
        <dialog id="dlg" aria-labelledby="dlg-name">
          <div class="dlg-wrap">
            <button class="close" id="dlg-close" aria-label={t.motionClose}>×</button>
            <div class="dlg">
              <div class="stage" id="dlg-stage"></div>
              <div class="info" id="dlg-info"></div>
            </div>
          </div>
        </dialog>
        <div class="fontwarm" aria-hidden="true" set:html={fontwarm}></div>
      </div>
      <div class="panel-foot sd-note">
        <p>{t.motionStyleFoot1}</p>
        <p>{t.motionStyleFoot2}</p>
        <p>{t.motionStyleFoot3}</p>
      </div>
    </div>

    <!-- 动效词典：原 motion.html，脚本在 public/style-motion/motion.js -->
    <div class="panel" id="panel-dict" role="tabpanel" aria-labelledby="tab-dict" data-refs={u('/style-motion/refs')} hidden>
      <div class="sm-motion">
        <div class="panel-intro">
          <p>{t.motionDictP}</p>
          <ol class="steps">
            <li><b>{t.motionStep1}</b>{t.motionStep1s}</li>
            <li><b>{t.motionStep2}</b>{t.motionStep2s}</li>
            <li><b>{t.motionStep3}</b>{t.motionStep3s}</li>
          </ol>
          <p class="legend">{t.motionLegend}<span class="term std">{t.motionTermStd}</span>{t.motionTermStdS}<span class="term en">{t.motionTermEn}</span>{t.motionTermEnS}<span class="term own">{t.motionTermOwn}</span>{t.motionTermOwnS}</p>
        </div>
        <div class="bar">
          <nav id="nav" aria-label={t.motionCatNav}></nav>
          <div class="glob">{t.motionAllSpeed}
            <div class="seg" id="gspeed"></div>
            <button type="button" class="tbtn" id="gpause">{t.motionPauseAll}</button>
            <button type="button" class="tbtn" id="gplay">{t.motionPlayAll}</button>
          </div>
        </div>
        <div id="app"></div>
        <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs id="fxdefs"></defs></svg>
      </div>
      <p class="panel-foot sd-note">{t.motionDictFoot}</p>
    </div>
  </section>
  <script is:inline>
  // 两个页签：#style 画风导览，#dict 动效词典（旧链接 #motion 和动效分类锚点也落到词典）。
  // 内联同步执行，首屏就是正确的页签，不会先闪一下画风页。
  (function () {
    var tabs = [].slice.call(document.querySelectorAll('[data-tab]'));
    var panels = { style: document.getElementById('panel-style'), dict: document.getElementById('panel-dict') };
    var DICT = ['#dict', '#motion', '#curves', '#text', '#texture', '#morph', '#trans', '#refs'];
    function show(name, setHash) {
      Object.keys(panels).forEach(function (k) { panels[k].hidden = k !== name; });
      tabs.forEach(function (t) { var on = t.dataset.tab === name; t.classList.toggle('on', on); t.setAttribute('aria-selected', String(on)); });
      if (setHash) history.replaceState(null, '', '#' + name);
    }
    function fromHash() { return DICT.indexOf(location.hash) >= 0 ? 'dict' : 'style'; }
    tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab === 'dict' ? 'dict' : 'style', true); }); });
    show(fromHash(), false);
    addEventListener('hashchange', function () { if (location.hash === '#style' || DICT.indexOf(location.hash) >= 0) show(fromHash(), false); });
  })();
  </script>
  {lang === 'en' && <script is:inline src={u('/style-motion/i18n-en.js')}></script>}
  {lang === 'en' && <script is:inline src={u('/style-motion/refs/catalog-en.js')}></script>}
  <script is:inline defer src={u('/style-motion/lib/three.min.js')}></script>
  <script is:inline defer src={u('/style-motion/styles.js')}></script>
  <script is:inline defer src={u('/style-motion/motion.js')}></script>
  <script is:inline defer src={u('/style-motion/refs.js')}></script>
</Base>
<style>
.formula{margin:0 0 72px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.formula>div{padding:22px 24px;display:grid;gap:6px;min-width:0;border:1px solid var(--line);border-radius:var(--r);background:var(--bg-2)}
.formula code{font-size:11px;color:var(--mint);letter-spacing:.12em}
.formula b{font-size:21px;font-weight:800}
.formula span{font-size:14px;color:var(--fg-2)}
.say{grid-column:1/-1;margin:4px 0 0;font-size:16px;color:var(--fg-2)}
.say .mono{font-size:11px;letter-spacing:.12em;color:var(--fg-3);margin-right:14px}
.say mark{background:none;color:var(--mint);font-weight:700;padding:0 2px}
.tabs{position:relative;z-index:6;display:inline-flex;padding:4px;margin-bottom:32px;border:1px solid var(--line-2);border-radius:999px;background:var(--bg-2)}
.seg-btn{border:0;background:transparent;color:var(--fg-2);padding:9px 18px;border-radius:999px;font-weight:600;font-size:14.5px;cursor:pointer;transition:background .25s,color .25s}
.seg-btn:hover{color:var(--fg)}
.seg-btn.on{background:var(--mint);color:var(--ink)}
.panel-intro{display:grid;gap:16px;max-width:48em;margin-bottom:28px;color:var(--fg-2);font-size:16px}
.panel-intro p{margin:0}
.panel-intro em{font-style:normal;color:var(--fg-3)}
.panel-intro b{color:var(--fg)}
.panel-intro .aside{font-size:14.5px;color:var(--fg-3);border-left:2px solid var(--mint);padding-left:14px}
.panel-foot{display:grid;gap:4px;margin-top:40px;padding-top:18px;border-top:1px solid var(--line)}
.panel-foot p{margin:0}
@media(max-width:720px){.formula{grid-template-columns:1fr;margin-bottom:48px}}
/* fonts.css 里的 JetBrains Mono 是演示用的子集，站点自身的等宽字不用它 */
:global(body){--mono:"Cascadia Code","SF Mono",Consolas,Menlo,monospace}
</style>
