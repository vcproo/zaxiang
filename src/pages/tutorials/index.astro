---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { allTutorials } from '../../lib';
const all = await allTutorials();
const tags = [...new Set(all.flatMap(t => t.data.tags))];
---
<Base title="全部教程">
<section class="wrap page">
  <header class="page-head">
    <p class="eyebrow rise">Archive / 教程档案</p>
    <h1 class="rise" style="animation-delay:.06s">全部教程</h1>
    <p class="intro rise" style="animation-delay:.12s">共 <span class="mono hl" id="count">{all.length}</span> 篇。按标签筛选，或直接搜索标题与内容摘要。</p>
  </header>
  <div class="tools rise" style="animation-delay:.18s">
    <label class="search">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
      <input id="q" type="search" placeholder="搜索教程，例如：提示词、Agent、本地部署" aria-label="搜索教程"/>
      <kbd class="mono" aria-hidden="true">/</kbd>
    </label>
    <div class="tags"><button class="sd-chip on" data-tag="">全部</button>{tags.map(t => <button class="sd-chip" data-tag={t}>#{t}</button>)}</div>
  </div>
  <div id="list">{all.map((t, i) => <Card t={t} idx={all.length - i}/>)}</div>
  <p id="empty" hidden>没有找到相关教程，换个关键词试试。</p>
</section>
</Base>
<style>
.tools{display:grid;gap:20px;margin-bottom:32px}
.search{display:flex;align-items:center;gap:14px;padding:0 18px;border:1px solid var(--line-2);border-radius:999px;background:var(--bg-2);transition:border-color .25s,box-shadow .25s}
.search:focus-within{border-color:var(--mint);box-shadow:0 0 0 5px var(--mint-glow)}
.search svg{flex:none;fill:none;stroke:var(--fg-3);stroke-width:1.8;stroke-linecap:round}
.search input{flex:1;min-width:0;font:17px var(--sans);padding:17px 0;border:0;background:transparent;color:var(--fg);outline:none}
.search input::placeholder{color:var(--fg-3)}
.search kbd{font-size:12px;padding:2px 8px;border:1px solid var(--line-2);border-radius:6px;color:var(--fg-3)}
.tags{display:flex;flex-wrap:wrap;gap:8px}
#list{border-bottom:1px solid var(--line)}
#empty{color:var(--fg-3);padding:60px 0;text-align:center}
:global(#list .row.hide){display:none}
@media(max-width:640px){.search kbd{display:none}}
</style>
<script>
const q = document.getElementById('q') as HTMLInputElement;
const rows = [...document.querySelectorAll<HTMLElement>('#list .row')];
const btns = [...document.querySelectorAll<HTMLButtonElement>('.tags .sd-chip')];
let tag = new URLSearchParams(location.search).get('tag') || '';
function apply() {
  const s = q.value.trim().toLowerCase(); let n = 0;
  rows.forEach(r => { const ok = (!tag || r.dataset.tags!.split(',').includes(tag)) && (!s || r.dataset.text!.includes(s)); r.classList.toggle('hide', !ok); if (ok) n++; });
  btns.forEach(b => b.classList.toggle('on', b.dataset.tag === tag));
  document.getElementById('count')!.textContent = String(n);
  document.getElementById('empty')!.hidden = n > 0;
}
btns.forEach(b => b.onclick = () => { tag = b.dataset.tag!; apply(); });
q.oninput = apply; apply();
// 按 / 直接聚焦搜索框
addEventListener('keydown', e => { if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); } });
</script>
