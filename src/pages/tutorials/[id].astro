---
import { u } from '../../url';
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { tutorialPaths, slugOf } from '../../lib';
import { ui, type Lang } from '../../i18n';
export async function getStaticPaths() {
  return tutorialPaths('zh');
}
const { t, prev, next, total, related, lang = 'zh' } = Astro.props as { t: any; prev: any; next: any; total: number; related: any[]; lang?: Lang };
const copy = ui[lang];
const { Content, headings } = await render(t);
const toc = headings.filter(h => h.depth === 2);
const caseNo = t.data.order ? `CASE-${String(t.data.order).padStart(3, '0')}` : 'CASE';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} title={t.data.title} description={t.data.description}>
<article class="art">
  <header class="wrap art-head">
    <div class="crumbs mono rise">
      <a href={u("/tutorials/", lang)}>{copy.crumb}</a>
      {t.data.series && <span>{t.data.series} · {pad(t.data.order ?? 0)} / {pad(total)}</span>}
    </div>
    {t.data.kicker && <p class="eyebrow rise" style="animation-delay:.04s">{t.data.kicker}</p>}
    <h1 class="rise" style="animation-delay:.08s">{t.data.title}</h1>
    <p class="desc rise" style="animation-delay:.14s">{t.data.description}</p>
    <p class="meta mono rise" style="animation-delay:.2s">
      <span>{caseNo}</span><span>{t.data.date.toISOString().slice(0, 10)}</span><span>{t.data.level}</span>
      {t.data.tags.map(g => <a href={u(`/tutorials/?tag=${encodeURIComponent(g)}`, lang)}>#{g}</a>)}
    </p>
    <div class="stamp" aria-hidden="true"><span>{copy.filed}</span><small class="mono">{caseNo}</small></div>
  </header>

  <div class:list={['wrap', 'art-body', { 'no-toc': !toc.length }]}>
    {toc.length > 0 && (
      <aside class="toc">
        <p class="eyebrow">{copy.toc}</p>
        <nav>{toc.map((h, i) => <a href={`#${h.slug}`}><span class="mono">{pad(i + 1)}</span>{h.text}</a>)}</nav>
      </aside>
    )}
    <div class="sheet">
      <div class="sheet-top mono" aria-hidden="true"><span>{caseNo} · {copy.sheet}</span><span>SPIDER DETECTIVE</span></div>
      <div class="prose"><Content/></div>
    </div>
  </div>

  <nav class="wrap pn" aria-label={copy.pnLabel}>
    {prev ? <a class="sd-card spot" href={u(`/tutorials/${slugOf(prev.id)}/`, lang)}><span class="mono">{copy.prev}</span><b>{prev.data.title}</b></a> : <span/>}
    {next ? <a class="sd-card spot r" href={u(`/tutorials/${slugOf(next.id)}/`, lang)}><span class="mono">{copy.next}</span><b>{next.data.title}</b></a> : <span/>}
  </nav>

  {related.length > 0 && (
    <section class="wrap board">
      <div class="sec-head"><div><p class="eyebrow">{copy.relatedEyebrow}</p><h2>{copy.relatedH}</h2></div></div>
      <div class="cork">
        <svg class="strings" aria-hidden="true"></svg>
        <div class="clue me"><b class="mono">{copy.thisCase} · {caseNo}</b>{t.data.title}</div>
        {related.map((r, i) => <a class={`clue n${i}`} href={u(`/tutorials/${slugOf(r.id)}/`, lang)}><b class="mono">{r.data.tags.filter((g: string) => t.data.tags.includes(g)).map((g: string) => '#' + g).join(' ')}</b>{r.data.title}</a>)}
      </div>
    </section>
  )}
</article>
</Base>
<style>
.art-head{position:relative;padding-top:64px;padding-bottom:56px;max-width:1124px}
.crumbs{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--fg-3);margin-bottom:40px;letter-spacing:.06em}
.crumbs a{color:var(--fg-2);text-decoration:none;transition:color .2s} .crumbs a:hover{color:var(--mint)}
h1{font-size:clamp(34px,5.4vw,62px);font-weight:800;line-height:1.16;letter-spacing:-.03em;margin:18px 0 20px;max-width:15em}
.desc{font-size:19px;color:var(--fg-2);margin:0 0 28px;max-width:36em}
.meta{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:12.5px;color:var(--fg-3);margin:0}
.meta a{color:var(--fg-2);text-decoration:none} .meta a:hover{color:var(--mint)}
.stamp{position:absolute;right:40px;bottom:64px;border:2.5px solid var(--red);color:var(--red);padding:8px 16px;border-radius:8px;transform:rotate(-9deg);
  display:flex;flex-direction:column;align-items:center;font:900 22px/1.15 var(--sans);letter-spacing:.24em;opacity:.9;
  animation:stamp .55s .45s cubic-bezier(.3,1.6,.5,1) both}
.stamp small{font-size:10.5px;letter-spacing:.12em;font-weight:600;margin-top:3px}
@keyframes stamp{0%{opacity:0;transform:rotate(-20deg) scale(2.6)}60%{opacity:.95}100%{opacity:.9;transform:rotate(-9deg) scale(1)}}

.art-body{display:grid;grid-template-columns:200px minmax(0,820px);gap:48px;justify-content:center;align-items:start}
.art-body.no-toc{grid-template-columns:minmax(0,820px)}
.toc{position:sticky;top:calc(var(--hdr) + 32px);display:grid;gap:14px}
.toc nav{display:grid;gap:2px;border-left:1px solid var(--line)}
.toc a{display:flex;gap:10px;padding:7px 0 7px 16px;margin-left:-1px;border-left:1.5px solid transparent;color:var(--fg-3);text-decoration:none;font-size:14px;line-height:1.5;transition:color .2s,border-color .2s}
.toc a span{font-size:11px;padding-top:2px;opacity:.7}
.toc a:hover{color:var(--fg)} .toc a.cur{color:var(--mint);border-color:var(--mint)}
.sheet{position:relative;background:linear-gradient(180deg,#F7F1E6,#F3EBDD 240px);color:var(--ink);border-radius:24px;padding:clamp(28px,5vw,64px);
  box-shadow:0 0 0 1px rgba(243,235,221,.3),0 40px 100px -40px rgba(0,0,0,.8)}
.sheet-top{display:flex;justify-content:space-between;gap:12px;font-size:10.5px;letter-spacing:.18em;color:#9A92A0;padding-bottom:18px;margin:-8px 0 40px;border-bottom:1px dashed #D6CBB8}

.pn{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:64px;max-width:1124px}
.pn a{display:grid;gap:8px;padding:24px 28px}
.pn a span{font-size:12px;letter-spacing:.1em;color:var(--fg-3)}
.pn a b{font-size:18px;line-height:1.45}
.pn .r{text-align:right}

.board{margin-top:96px;max-width:1124px}
.cork{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:28px;padding:72px 32px 44px;border-radius:var(--r);border:1px solid var(--line);
  background:radial-gradient(rgba(243,235,221,.07) 1px,transparent 1.3px) 0 0/16px 16px,var(--bg-2)}
.strings{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:3}
.strings :global(path){fill:none;stroke:var(--red);stroke-width:1.6;stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.1s var(--ease)}
.cork.drawn .strings :global(path){stroke-dashoffset:0}
.clue{position:relative;z-index:2;background:var(--cream);color:var(--ink);padding:24px 16px 16px;border-radius:4px;font-weight:700;font-size:15.5px;line-height:1.5;text-decoration:none;
  box-shadow:0 14px 30px -10px rgba(0,0,0,.6);transition:transform .45s var(--spring);display:flex;flex-direction:column;gap:8px}
.clue b{font-size:10.5px;color:#857D8B;font-weight:500;letter-spacing:.04em}
.clue::before{content:"";position:absolute;top:-6px;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:var(--red);box-shadow:0 2px 4px rgba(0,0,0,.4),inset 0 -2px 0 rgba(0,0,0,.2)}
.clue.me{background:var(--mint)} .clue.me b{color:#2C7A5E}
.n0{transform:rotate(-2deg)} .n1{transform:rotate(1.5deg) translateY(16px)} .n2{transform:rotate(-1deg)} .me{transform:rotate(1deg)}
a.clue:hover{transform:rotate(0) translateY(-6px) scale(1.03)}

@media(max-width:1060px){.art-body{grid-template-columns:minmax(0,820px)}.toc{display:none}}
@media(max-width:860px){.stamp{position:static;display:inline-flex;margin-top:28px;font-size:16px}.cork{grid-template-columns:1fr 1fr;padding:36px 18px}}
@media(max-width:640px){.art-head{padding-top:36px;padding-bottom:36px}.crumbs{margin-bottom:28px}.desc{font-size:17px}
  .art-body{padding:0 10px}.sheet{border-radius:18px;padding:28px 20px}.sheet-top span:last-child{display:none}
  .pn{grid-template-columns:1fr}.pn .r{text-align:left}}
</style>
<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
// 目录高亮
const prose = document.querySelector('.prose') as HTMLElement;
const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
let tk = false;
function spy() {
  let cur = ''; prose.querySelectorAll('h2').forEach(h => { if (h.getBoundingClientRect().top < 140) cur = h.id; });
  links.forEach(a => a.classList.toggle('cur', a.getAttribute('href') === '#' + cur)); tk = false;
}
if (links.length) { addEventListener('scroll', () => { if (!tk) { tk = true; requestAnimationFrame(spy); } }, { passive: true }); spy(); }
// 红线：把「本案」与关联教程连起来
const cork = document.querySelector('.cork') as HTMLElement | null;
if (cork) {
  const svg = cork.querySelector('.strings') as SVGSVGElement;
  const draw = () => { const b = cork.getBoundingClientRect(); const pin = (el: Element) => { const r = el.getBoundingClientRect(); return [r.left + r.width / 2 - b.left, r.top - b.top]; };
    const me = cork.querySelector('.me'); if (!me) return;
    const [mx, my] = pin(me);
    svg.innerHTML = [...cork.querySelectorAll('a.clue')].map(n => { const [x, y] = pin(n); const lift = Math.min(44, 14 + Math.abs(x - mx) * .05);
      return `<path d="M${mx} ${my} Q ${(mx + x) / 2} ${Math.min(my, y) - lift} ${x} ${y}"/>`; }).join('');
    svg.querySelectorAll('path').forEach(p => p.style.setProperty('--len', String(p.getTotalLength() + 2))); };
  draw(); addEventListener('resize', draw);
  if (reduce) cork.classList.add('drawn');
  else new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { cork.classList.add('drawn'); o.disconnect(); } }, { threshold: .35 }).observe(cork);
}
</script>
