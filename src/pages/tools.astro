---
import Base from '../layouts/Base.astro';
const tools = [
  {
    name: 'Claude AI IP 风险检测',
    url: 'https://ip.net.coffee/claude/',
    domain: 'ip.net.coffee',
    category: '网络检测',
    description: '查看 Claude 出口 IP 的风险、网络属性与可用性，辅助排查连接问题。',
  },
];
---
<Base title="工具导航" description="蜘蛛侦探的工具导航，收藏实用工具与常用链接。">
  <section class="wrap tools-page">
    <header>
      <p class="eyebrow mono">TOOLKIT / 工具档案</p>
      <h1>顺手的工具，放在这里。</h1>
      <p class="intro">收藏实用工具与常用链接，需要时随手打开。</p>
    </header>
    <div class="tool-grid">
      {tools.map(tool => (
        <a class="tool-card" href={tool.url} target="_blank" rel="noopener noreferrer" aria-label={`${tool.name}（在新标签页打开）`}>
          <div class="card-top"><span class="category">{tool.category}</span><span class="arrow" aria-hidden="true">↗</span></div>
          <h2>{tool.name}</h2>
          <p>{tool.description}</p>
          <div class="card-bottom"><span class="mono">{tool.domain}</span><span>打开工具 ↗</span></div>
        </a>
      ))}
    </div>
    <p class="note">工具链接将在新标签页打开。</p>
  </section>
</Base>
<style>
.tools-page{padding-top:60px;min-height:65vh}
.eyebrow{font-size:12px;color:var(--ink-3);letter-spacing:.12em}
h1{font-family:var(--serif);font-size:clamp(30px,5vw,48px);line-height:1.35;margin:14px 0}
.intro{color:var(--ink-2);margin-bottom:36px}
.tool-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.tool-card{display:flex;flex-direction:column;padding:26px;border:1px solid var(--line);border-radius:var(--r);background:#fbf9f4;text-decoration:none;transition:border-color .2s,box-shadow .2s,transform .2s}
.tool-card:hover{border-color:var(--ink);box-shadow:4px 4px 0 var(--pin);transform:translate(-2px,-2px)}
.tool-card:focus-visible{outline:3px solid var(--pin);outline-offset:4px}
.card-top,.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px}
.category{font-size:12px;background:var(--paper-2);padding:3px 9px;border-radius:3px;color:var(--ink-2)}
.arrow{font-size:24px}h2{font-family:var(--serif);font-size:23px;line-height:1.5;margin:22px 0 10px}
.tool-card p{font-size:15px;color:var(--ink-2);margin:0 0 26px}
.card-bottom{margin-top:auto;padding-top:16px;border-top:1px solid var(--line);font-size:12px;flex-wrap:wrap}
.card-bottom .mono{color:var(--ink-3)}.note{font-size:13px;color:var(--ink-3);margin-top:24px}
@media(max-width:960px){.tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.tools-page{padding-top:32px}.tool-grid{grid-template-columns:1fr}}
</style>
