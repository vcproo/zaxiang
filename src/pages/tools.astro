---
import Base from '../layouts/Base.astro';
import { tools } from '../tools';
---
<Base title="工具导航" description="蜘蛛侦探的工具导航，收藏实用工具与常用链接。">
  <section class="wrap page">
    <header class="page-head">
      <p class="eyebrow rise">Toolkit / 工具档案</p>
      <h1 class="rise" style="animation-delay:.06s">顺手的工具，放在这里。</h1>
      <p class="intro rise" style="animation-delay:.12s">收藏实用工具与常用链接，需要时随手打开。</p>
    </header>
    <div class="grid">
      {tools.map((tool, i) => (
        <a class="tool sd-card spot reveal" style={`--d:${i * .06}s`} href={tool.url} target="_blank" rel="noopener noreferrer" aria-label={`${tool.name}（在新标签页打开）`}>
          <div class="top"><span class="cat mono">{tool.category}</span><span class="arrow" aria-hidden="true">↗</span></div>
          <h2>{tool.name}</h2>
          <p>{tool.description}</p>
          <div class="bottom mono"><span>{tool.domain}</span><span>打开工具</span></div>
        </a>
      ))}
    </div>
    <p class="sd-note">工具链接将在新标签页打开。</p>
  </section>
</Base>
<style>
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.tool{display:flex;flex-direction:column;padding:28px;min-height:280px}
.top,.bottom{display:flex;align-items:center;justify-content:space-between;gap:12px}
.cat{font-size:11.5px;letter-spacing:.1em;padding:5px 11px;border:1px solid var(--line-2);border-radius:999px;color:var(--fg-2)}
.arrow{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;border:1px solid var(--line-2);font-size:16px;transition:all .45s var(--spring)}
.tool:hover .arrow{background:var(--mint);border-color:var(--mint);color:var(--ink);transform:rotate(45deg)}
h2{font-size:23px;font-weight:800;line-height:1.4;margin:28px 0 10px;letter-spacing:-.01em}
p{font-size:15px;color:var(--fg-2);margin:0 0 26px}
.bottom{margin-top:auto;padding-top:16px;border-top:1px solid var(--line);font-size:12px;color:var(--fg-3);flex-wrap:wrap}
.bottom span:last-child{color:var(--mint)}
@media(max-width:960px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
</style>
