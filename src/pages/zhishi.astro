---
import { u } from '../url';
import Base from '../layouts/Base.astro';
import { NODES, EDGES, GROUPS, GROUP_COLOR } from '../zhishi';

const W = 1100, H = 720;
const RING = [0, 195, 310];
const seeded = NODES.map(n => {
  const r = RING[n.ring];
  const a = (n.angle - 90) * Math.PI / 180;
  return {
    ...n,
    x: W / 2 + r * Math.cos(a) + (n.kind === 'hub' ? 0 : Math.sin(n.angle) * 8),
    y: H / 2 + r * Math.sin(a),
    href: n.href ? u(n.href) : undefined,
    color: GROUP_COLOR[n.group],
    r: n.kind === 'hub' ? 28 : n.kind === 'lesson' ? 11 : 7,
  };
});
const data = { nodes: seeded, edges: EDGES, groups: GROUPS, W, H };
---
<Base title="知识蛛网" description="侦办级 AI 知识网络：把零散线索连成可追踪的案情图。">
<section class="zh">
  <header class="zh-head wrap">
    <div class="zh-meta mono">
      <span>GRAPH · KNOWLEDGE NET</span>
      <span>NODES {NODES.length}</span>
      <span>EDGES {EDGES.length}</span>
      <span>STATUS ACTIVE</span>
    </div>
    <h1>知识网络</h1>
    <p class="lead">像蜘蛛织网一样，把零散的 AI 知识点连成一张能用的网；像侦探查案一样，对每条线索先问：它和谁相连、证据在哪。点选节点，邻域高亮；有档案的节点可进入教程。</p>
  </header>

  <div class="zh-stage wrap">
    <div class="panel" id="panel">
      <div class="hud mono">
        <span id="hud-mode">VIEW · OVERVIEW</span>
        <span id="hud-sel">SEL —</span>
        <button type="button" class="hud-btn" id="reset" hidden>RESET VIEW</button>
      </div>
      <canvas id="g" width={W} height={H} aria-label="AI 知识网络图"></canvas>
      <div class="tip mono" id="tip" hidden></div>
      <p class="hint mono">拖拽画布平移 · 滚轮缩放 · 点击节点聚焦 · 再次点击进入档案</p>
    </div>

    <aside class="dossier">
      <h2 class="mono">BRIEF</h2>
      <p>中心节点 <b>AI</b> 为锚。实心节点对应白话课专案（C-01…C-10），可下钻至全文。虚线环节点为延伸概念（X-系列），暂存简报。</p>
      <h2 class="mono">LEGEND</h2>
      <ul class="legend">
        {GROUPS.map(g => (
          <li><i style={`background:${g.color};box-shadow:0 0 8px ${g.color}55`}></i>
            <span><b class="mono">{g.id}</b>{g.tip}</span></li>
        ))}
      </ul>
      <h2 class="mono">OPS</h2>
      <ul class="ops">
        <li>悬停：邻域边线发光</li>
        <li>单击：聚焦并锁定邻域</li>
        <li>聚焦后再击：打开教程</li>
        <li>空白处 / RESET：恢复全景</li>
      </ul>
      <a class="sd-btn" href={u('/baihuake/')}>按序列阅读白话课 →</a>
    </aside>
  </div>
</section>
</Base>

<script define:vars={{ data }}>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const canvas = document.getElementById('g');
const ctx = canvas.getContext('2d');
const panel = document.getElementById('panel');
const tip = document.getElementById('tip');
const resetBtn = document.getElementById('reset');
const hudMode = document.getElementById('hud-mode');
const hudSel = document.getElementById('hud-sel');

const nodes = data.nodes.map(n => ({ ...n, vx: 0, vy: 0 }));
const byId = Object.fromEntries(nodes.map(n => [n.id, n]));
const edges = data.edges.map(e => ({ ...e, a: byId[e.from], b: byId[e.to] }));
const adj = {};
nodes.forEach(n => adj[n.id] = new Set());
edges.forEach(e => { adj[e.from].add(e.to); adj[e.to].add(e.from); });

let dpr = Math.min(2, devicePixelRatio || 1);
let view = { x: 0, y: 0, k: 1 };
let hover = null, focus = null;
let dragging = null, panning = null;
let signals = []; // {e, t}
let running = true;

function resize() {
  const rect = canvas.getBoundingClientRect();
  dpr = Math.min(2, devicePixelRatio || 1);
  canvas.width = Math.floor(rect.width * dpr);
  canvas.height = Math.floor(rect.height * dpr);
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
resize();
addEventListener('resize', resize);

// —— force simulation (light) ——
const CX = data.W / 2, CY = data.H / 2;
function tickForce(iter = 1) {
  for (let k = 0; k < iter; k++) {
    // repulsion
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        let dx = b.x - a.x, dy = b.y - a.y;
        let d2 = dx * dx + dy * dy || 0.01;
        const d = Math.sqrt(d2);
        const f = 900 / d2;
        dx = dx / d * f; dy = dy / d * f;
        a.vx -= dx; a.vy -= dy; b.vx += dx; b.vy += dy;
      }
    }
    // springs
    edges.forEach(e => {
      const a = e.a, b = e.b;
      let dx = b.x - a.x, dy = b.y - a.y;
      const d = Math.hypot(dx, dy) || 0.01;
      const ideal = (a.kind === 'hub' || b.kind === 'hub') ? 170
        : (a.kind === 'concept' || b.kind === 'concept') ? 120 : 140;
      const f = (d - ideal) * 0.045;
      dx = dx / d * f; dy = dy / d * f;
      a.vx += dx; a.vy += dy; b.vx -= dx; b.vy -= dy;
    });
    // center gravity + hub pin
    nodes.forEach(n => {
      if (n.kind === 'hub') { n.vx += (CX - n.x) * 0.08; n.vy += (CY - n.y) * 0.08; }
      else { n.vx += (CX - n.x) * 0.008; n.vy += (CY - n.y) * 0.008; }
      n.vx *= 0.78; n.vy *= 0.78;
      n.x += n.vx; n.y += n.vy;
    });
    byId.ai.x = CX; byId.ai.y = CY; byId.ai.vx = 0; byId.ai.vy = 0;
  }
}
if (!reduce) tickForce(180); else tickForce(220);

function nbr(id) { return new Set([id, ...adj[id]]); }

function toWorld(clientX, clientY) {
  const r = canvas.getBoundingClientRect();
  const sx = r.width / data.W, sy = r.height / data.H;
  return {
    x: (clientX - r.left - view.x) / (view.k * sx),
    y: (clientY - r.top - view.y) / (view.k * sy),
  };
}
function toScreen(wx, wy) {
  const r = canvas.getBoundingClientRect();
  const sx = r.width / data.W, sy = r.height / data.H;
  return {
    x: r.left + view.x + wx * view.k * sx,
    y: r.top + view.y + wy * view.k * sy,
  };
}
// expose for QA
canvas.__net = { nodes, toScreen, setFocus, byId };

function hit(wx, wy) {
  let best = null, bd = 1e9;
  for (const n of nodes) {
    const d = Math.hypot(n.x - wx, n.y - wy);
    if (d < n.r + 16 && d < bd) { bd = d; best = n; }
  }
  return best;
}

function setFocus(n) {
  focus = n;
  resetBtn.hidden = !n;
  if (!n) {
    view = { x: 0, y: 0, k: 1 };
    hudMode.textContent = 'VIEW · OVERVIEW';
    hudSel.textContent = 'SEL —';
    signals = [];
  } else {
    hudMode.textContent = 'VIEW · FOCUS';
    hudSel.textContent = `SEL ${n.caseId} · ${n.label}`;
    const r = canvas.getBoundingClientRect();
    const scale = 1.35;
    view.k = scale;
    view.x = r.width / 2 - n.x / data.W * r.width * scale;
    view.y = r.height / 2 - n.y / data.H * r.height * scale;
    if (!reduce) {
      signals = edges
        .filter(e => e.from === n.id || e.to === n.id)
        .map((e, i) => ({ e, t: -i * 0.12 }));
    }
  }
}

function showTip(n, cx, cy) {
  tip.hidden = false;
  tip.innerHTML = `<div class="t-id">${n.caseId} · ${n.group}</div><div class="t-title">${n.label}</div><div class="t-body">${n.blurb}</div><div class="t-act">${n.href ? 'CLICK · OPEN DOSSIER' : 'INTEL ONLY · NO DOSSIER'}</div>`;
  const br = panel.getBoundingClientRect();
  tip.style.left = Math.min(cx - br.left + 14, br.width - 260) + 'px';
  tip.style.top = Math.min(cy - br.top + 14, br.height - 120) + 'px';
}
function hideTip() { tip.hidden = true; }

canvas.addEventListener('pointermove', e => {
  if (panning) {
    view.x += e.clientX - panning.x;
    view.y += e.clientY - panning.y;
    panning = { x: e.clientX, y: e.clientY };
    return;
  }
  if (dragging) {
    const w = toWorld(e.clientX, e.clientY);
    dragging.x = w.x; dragging.y = w.y; dragging.vx = 0; dragging.vy = 0;
    return;
  }
  const w = toWorld(e.clientX, e.clientY);
  const n = hit(w.x, w.y);
  hover = n;
  canvas.style.cursor = n ? 'pointer' : (e.buttons ? 'grabbing' : 'grab');
  if (n) showTip(n, e.clientX, e.clientY); else hideTip();
});
let down = null;
canvas.addEventListener('pointerdown', e => {
  const w = toWorld(e.clientX, e.clientY);
  const n = hit(w.x, w.y);
  down = { x: e.clientX, y: e.clientY, n };
  if (n) { dragging = n; }
  else { panning = { x: e.clientX, y: e.clientY }; }
  canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointerup', e => {
  const moved = down ? Math.hypot(e.clientX - down.x, e.clientY - down.y) : 99;
  const wasDrag = dragging;
  dragging = null; panning = null;
  if (moved > 6) { down = null; return; }
  const w = toWorld(e.clientX, e.clientY);
  const n = hit(w.x, w.y) || down?.n;
  down = null;
  if (n) {
    if (focus && focus.id === n.id && n.href) { location.href = n.href; return; }
    if (n.kind === 'hub') setFocus(null);
    else setFocus(n);
  } else if (focus) {
    setFocus(null);
  }
});
canvas.addEventListener('pointerleave', () => { hover = null; hideTip(); });
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  const r = canvas.getBoundingClientRect();
  const mx = e.clientX - r.left, my = e.clientY - r.top;
  const factor = e.deltaY > 0 ? 0.92 : 1.08;
  const nk = Math.min(2.4, Math.max(0.55, view.k * factor));
  view.x = mx - (mx - view.x) * (nk / view.k);
  view.y = my - (my - view.y) * (nk / view.k);
  view.k = nk;
}, { passive: false });

resetBtn.addEventListener('click', () => setFocus(null));

// —— render ——
function draw() {
  const r = canvas.getBoundingClientRect();
  const sx = r.width / data.W, sy = r.height / data.H;
  ctx.save();
  ctx.clearRect(0, 0, r.width, r.height);
  // board bg handled by CSS; subtle inner grid
  ctx.fillStyle = '#12110F';
  ctx.fillRect(0, 0, r.width, r.height);
  ctx.save();
  ctx.translate(view.x, view.y);
  ctx.scale(view.k * sx, view.k * sy);

  const active = focus || hover;
  const set = active ? nbr(active.id) : null;

  // grid in world
  ctx.strokeStyle = 'rgba(232,184,74,0.04)';
  ctx.lineWidth = 1 / (view.k * sx);
  for (let x = 0; x < data.W; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, data.H); ctx.stroke(); }
  for (let y = 0; y < data.H; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(data.W, y); ctx.stroke(); }

  // faint orbit rings
  ctx.strokeStyle = 'rgba(255,255,255,0.035)';
  [160, 250, 340].forEach(rad => {
    ctx.beginPath(); ctx.arc(CX, CY, rad, 0, Math.PI * 2); ctx.stroke();
  });

  // edges
  edges.forEach(e => {
    const a = e.a, b = e.b;
    const lit = set && set.has(a.id) && set.has(b.id) && (a.id === active.id || b.id === active.id);
    const dim = set && !lit;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    if (lit) {
      ctx.strokeStyle = 'rgba(232,184,74,0.95)';
      ctx.lineWidth = 1.8;
      ctx.shadowColor = '#E8B84A';
      ctx.shadowBlur = reduce ? 0 : 12;
    } else if (dim) {
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.lineWidth = 1;
      ctx.shadowBlur = 0;
    } else {
      ctx.strokeStyle = 'rgba(200,190,170,0.22)';
      ctx.lineWidth = 1;
      ctx.shadowBlur = 0;
    }
    ctx.stroke();
    ctx.shadowBlur = 0;
  });

  // signals
  if (!reduce && signals.length) {
    signals.forEach(s => {
      s.t += 0.016;
      if (s.t < 0 || s.t > 1.2) return;
      const t = Math.min(1, s.t);
      const x = s.e.a.x + (s.e.b.x - s.e.a.x) * t;
      const y = s.e.a.y + (s.e.b.y - s.e.a.y) * t;
      ctx.beginPath();
      ctx.arc(x, y, 2.2, 0, Math.PI * 2);
      ctx.fillStyle = '#F2C230';
      ctx.shadowColor = '#F2C230';
      ctx.shadowBlur = 10;
      ctx.fill();
      ctx.shadowBlur = 0;
    });
    if (signals.every(s => s.t > 1.2)) {
      // loop softly while focused
      if (focus) signals.forEach((s, i) => { s.t = -i * 0.12; });
    }
  }

  // nodes
  nodes.forEach(n => {
    const on = active && n.id === active.id;
    const inSet = !set || set.has(n.id);
    const alpha = inSet ? 1 : 0.18;
    ctx.globalAlpha = alpha;

    // glow
    if (on || (set && inSet && active)) {
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r + (on ? 10 : 5), 0, Math.PI * 2);
      ctx.fillStyle = n.color + (on ? '33' : '18');
      ctx.fill();
    }

    ctx.beginPath();
    ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
    if (n.kind === 'hub') {
      ctx.fillStyle = '#1A1814';
      ctx.fill();
      ctx.lineWidth = 2.2;
      ctx.strokeStyle = n.color;
      ctx.shadowColor = n.color;
      ctx.shadowBlur = reduce ? 0 : 16;
      ctx.stroke();
      ctx.shadowBlur = 0;
      // inner amber core
      ctx.beginPath();
      ctx.arc(n.x, n.y, 8, 0, Math.PI * 2);
      ctx.fillStyle = n.color;
      ctx.fill();
    } else if (n.kind === 'lesson') {
      ctx.fillStyle = '#1A1814';
      ctx.fill();
      ctx.lineWidth = on ? 2 : 1.4;
      ctx.strokeStyle = n.color;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(n.x, n.y, 3.2, 0, Math.PI * 2);
      ctx.fillStyle = n.color;
      ctx.fill();
    } else {
      ctx.fillStyle = '#141310';
      ctx.fill();
      ctx.setLineDash([2.5, 2]);
      ctx.lineWidth = 1.2;
      ctx.strokeStyle = n.color;
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // labels
    ctx.globalAlpha = inSet ? 0.95 : 0.2;
    ctx.font = n.kind === 'hub'
      ? '700 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace'
      : '500 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
    ctx.fillStyle = on ? '#F5F0E6' : '#C8C0B0';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    const ly = n.y + n.r + 6;
    ctx.fillText(n.label, n.x, ly);
    if (n.kind !== 'hub') {
      ctx.font = '400 9px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
      ctx.fillStyle = on ? n.color : '#6E685C';
      ctx.fillText(n.caseId, n.x, ly + 13);
    }
    ctx.globalAlpha = 1;
  });

  ctx.restore();
  ctx.restore();
  if (running) requestAnimationFrame(draw);
}
running = true;
requestAnimationFrame(draw);

// stop sim drift; keep RAF for signals/hover
</script>

<style>
/* 本页覆盖：深色侦办台，不影响全站纸感 */
:global(body:has(.zh)) {
  background: #0E0D0B;
  background-image:
    radial-gradient(ellipse at 20% 0%, rgba(232,184,74,.06), transparent 50%),
    radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
  background-size: auto, 3px 3px;
  color: #E8E2D6;
}
:global(body:has(.zh) .top) {
  background: rgba(14,13,11,.9);
  border-bottom-color: #2A2824;
}
:global(body:has(.zh) .top a) { color: #A8A090; }
:global(body:has(.zh) .top a.cur) { background: #1C1A16; color: #F2C230; }
:global(body:has(.zh) .logo) { color: #E8E2D6; }
:global(body:has(.zh) footer) { border-top-color: #2A2824; color: #6E685C; }
:global(body:has(.zh) .dangle) { display: none; }

.zh-head { padding-top: 40px; max-width: 820px; }
.zh-meta { display: flex; flex-wrap: wrap; gap: 14px 22px; font-size: 11px; letter-spacing: .12em; color: #6E685C; margin-bottom: 16px; }
.zh-meta span:first-child { color: #E8B84A; }
.zh h1 { font-family: var(--serif); font-size: clamp(28px, 4vw, 42px); margin: 0 0 12px; font-weight: 700; color: #F5F0E6; letter-spacing: .02em; }
.lead { margin: 0; font-size: 16.5px; line-height: 1.75; color: #A8A090; max-width: 42em; }

.zh-stage { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 28px; margin-top: 28px; padding-bottom: 48px; align-items: start; }
.panel { position: relative; border: 1px solid #2E2B26; border-radius: 4px; background: #12110F; overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(232,184,74,.06), 0 0 40px rgba(0,0,0,.45); }
.hud { display: flex; gap: 16px; align-items: center; padding: 10px 14px; border-bottom: 1px solid #2A2824;
  font-size: 11px; letter-spacing: .1em; color: #6E685C; background: #16140F; }
.hud #hud-mode { color: #E8B84A; }
.hud-btn { margin-left: auto; font: inherit; letter-spacing: .1em; font-size: 10px; color: #0E0D0B; background: #E8B84A;
  border: 0; padding: 5px 10px; border-radius: 2px; cursor: pointer; }
.hud-btn:hover { filter: brightness(1.08); }
#g { display: block; width: 100%; height: auto; aspect-ratio: 1100 / 720; cursor: grab; touch-action: none; }
.hint { margin: 0; padding: 8px 14px; font-size: 10px; letter-spacing: .08em; color: #5A554C; border-top: 1px solid #2A2824; }

.tip { position: absolute; z-index: 5; width: 240px; padding: 12px 14px; pointer-events: none;
  background: rgba(18,17,15,.94); border: 1px solid #3A3630; border-left: 2px solid #E8B84A;
  box-shadow: 0 12px 40px rgba(0,0,0,.5); }
.tip .t-id { font-size: 10px; letter-spacing: .14em; color: #E8B84A; margin-bottom: 4px; }
.tip .t-title { font-family: var(--serif); font-size: 18px; color: #F5F0E6; font-weight: 700; margin-bottom: 6px; }
.tip .t-body { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: #A8A090; margin-bottom: 8px; }
.tip .t-act { font-size: 10px; letter-spacing: .1em; color: #6E685C; }

.dossier h2 { font-size: 11px; letter-spacing: .16em; color: #E8B84A; margin: 0 0 10px; font-weight: 600; }
.dossier h2 + p, .dossier .ops { font-size: 13.5px; line-height: 1.65; color: #A8A090; margin: 0 0 22px; }
.dossier b { color: #E8E2D6; font-weight: 600; }
.legend { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-direction: column; gap: 10px; }
.legend li { display: flex; gap: 10px; font-size: 12.5px; color: #A8A090; }
.legend i { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex: none; }
.legend b { display: block; color: #D8D0C0; font-size: 11px; letter-spacing: .06em; margin-bottom: 1px; }
.ops { padding-left: 1.1em; margin: 0 0 22px; }
.ops li { margin-bottom: 4px; }
.dossier .sd-btn { background: #E8B84A; color: #0E0D0B; border-color: #E8B84A; box-shadow: none; font-size: 14px; }
.dossier .sd-btn:hover { box-shadow: 3px 3px 0 #5A4300; }

@media (max-width: 960px) {
  .zh-stage { grid-template-columns: 1fr; }
  .dossier { order: 2; }
}
@media (prefers-reduced-motion: reduce) {
  .tip { transition: none; }
}
</style>
