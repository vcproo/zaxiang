---
import { u } from '../url';
import Base from '../layouts/Base.astro';
import { NODES, EDGES, GROUPS } from '../zhishi';

const CX = 500, CY = 500;
const RING_R = [0, 210, 340];
const data = {
  nodes: NODES.map(n => {
    const r = RING_R[n.ring];
    const a = (n.angle - 90) * Math.PI / 180;
    return { ...n, x: CX + r * Math.cos(a), y: CY + r * Math.sin(a), href: n.href ? u(n.href) : undefined };
  }),
  edges: EDGES,
  groups: GROUPS,
  base: import.meta.env.BASE_URL,
};
---
<Base title="知识蛛网" description="像蜘蛛织网一样，把零散的 AI 知识点连成一张能用的网。">
<section class="wrap head">
  <p class="mono kicker">CASE BOARD · 知识蛛网</p>
  <h1>把零散的知识点，织成一张能用的网</h1>
  <p class="lead">像蜘蛛织网一样，我把零散的 AI 知识点连成一张能用的网；像侦探查案一样，我对每个新工具都先问一句：它到底是怎么做到的？点一个节点，顺着蛛丝摸到相关的课。</p>
</section>

<section class="stage wrap">
  <div class="board" id="board">
    <svg class="web" id="web" viewBox="0 0 1000 1000" role="img" aria-label="AI 知识蛛网">
      <defs>
        <radialGradient id="gHub" cx="50%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#FFF6C8"/><stop offset="100%" stop-color="#F2C230"/>
        </radialGradient>
        <filter id="soft"><feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity=".25"/></filter>
      </defs>
      <g class="scaffold" aria-hidden="true">
        {[90, 170, 250, 340].map(r => <circle class="ring" cx={CX} cy={CY} r={r}/>)}
        {Array.from({ length: 12 }, (_, i) => {
          const a = (i * 30 - 90) * Math.PI / 180;
          return <line class="spoke" x1={CX} y1={CY} x2={CX + 340 * Math.cos(a)} y2={CY + 340 * Math.sin(a)}/>;
        })}
      </g>
      <g class="edges"></g>
      <g class="nodes"></g>
    </svg>
    <div class="tip" id="tip" hidden></div>
    <button class="reset mono" id="reset" type="button" hidden>⊙ 回到全景</button>
  </div>

  <aside class="side">
    <h2>怎么读这张网</h2>
    <ol>
      <li><b>中心是 AI</b>——所有线索从这里出发。</li>
      <li><b>黄色图钉</b>是白话课里的十个热词，点进去能读完整教程。</li>
      <li><b>空心节点</b>是延伸概念，暂时只有一句简介。</li>
      <li>悬停或点选时，相关蛛丝会亮成红色；再点一次中心可回到全景。</li>
    </ol>
    <h2>图例</h2>
    <ul class="legend">
      {GROUPS.map(g => <li><i style={`background:${g.color}`}></i><span><b>{g.id}</b>{g.tip}</span></li>)}
    </ul>
    <p class="note mono">共 {NODES.filter(n => n.kind === 'lesson').length} 门课 · {NODES.filter(n => n.kind === 'concept').length} 个延伸概念 · 可继续加深</p>
    <a class="sd-btn" href={u('/baihuake/')}>按顺序读白话课 →</a>
  </aside>
</section>
</Base>

<script define:vars={{ data }}>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const svg = document.getElementById('web');
const eg = svg.querySelector('.edges');
const ng = svg.querySelector('.nodes');
const tip = document.getElementById('tip');
const reset = document.getElementById('reset');
const board = document.getElementById('board');
const byId = Object.fromEntries(data.nodes.map(n => [n.id, n]));
const adj = {};
data.nodes.forEach(n => adj[n.id] = new Set());
data.edges.forEach(e => { adj[e.from].add(e.to); adj[e.to].add(e.from); });

function len(a, b) { return Math.hypot(b.x - a.x, b.y - a.y); }
function pathD(a, b) {
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
  const dx = b.x - a.x, dy = b.y - a.y;
  const cx = mx - dy * 0.08, cy = my + dx * 0.08;
  return `M${a.x} ${a.y} Q ${cx} ${cy} ${b.x} ${b.y}`;
}

// edges
const edgeEls = data.edges.map(e => {
  const a = byId[e.from], b = byId[e.to];
  const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
  p.setAttribute('d', pathD(a, b));
  p.setAttribute('class', 'silk');
  p.dataset.from = e.from; p.dataset.to = e.to;
  const L = p.getTotalLength ? 0 : 0;
  eg.appendChild(p);
  const ll = p.getTotalLength();
  p.style.setProperty('--len', ll);
  p.style.strokeDasharray = String(ll);
  p.style.strokeDashoffset = reduce ? '0' : String(ll);
  return p;
});

// nodes
const nodeEls = {};
data.nodes.forEach((n, i) => {
  const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  g.setAttribute('transform', `translate(${n.x} ${n.y})`);
  const inner = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  inner.dataset.id = n.id;
  inner.setAttribute('class', `node kind-${n.kind} group-${n.group}`);
  inner.style.setProperty('--i', String(i));
  inner.setAttribute('tabindex', '0');
  inner.setAttribute('role', 'button');
  inner.setAttribute('aria-label', `${n.label}：${n.blurb}`);
  if (n.kind === 'hub') {
    inner.innerHTML = `<circle class="pin-shadow" r="38" fill="#17150F" opacity=".12" cy="4"/><circle class="body" r="36" fill="url(#gHub)" stroke="#17150F" stroke-width="3"/><text class="lab hub" text-anchor="middle" dy=".35em">${n.label}</text>`;
  } else if (n.kind === 'lesson') {
    inner.innerHTML = `<circle class="pin-shadow" r="26" fill="#17150F" opacity=".1" cy="3"/><circle class="body" r="24" fill="#F2C230" stroke="#17150F" stroke-width="2.5"/><circle class="dot" r="4" fill="#17150F"/><text class="lab" text-anchor="middle" y="40">${n.label}</text>`;
  } else {
    inner.innerHTML = `<circle class="body" r="18" fill="#FBF9F4" stroke="#17150F" stroke-width="1.8" stroke-dasharray="3 2"/><text class="lab" text-anchor="middle" y="34">${n.label}</text>`;
  }
  g.appendChild(inner);
  ng.appendChild(g);
  nodeEls[n.id] = inner;
});

let focus = null, hover = null;

function neighbors(id) {
  const s = new Set([id, ...adj[id]]);
  return s;
}

function paint() {
  const hi = hover || focus;
  const set = hi ? neighbors(hi) : null;
  svg.classList.toggle('is-focus', !!focus);
  svg.classList.toggle('is-hover', !!hover && !focus);
  edgeEls.forEach(p => {
    const on = set && (set.has(p.dataset.from) && set.has(p.dataset.to) && (p.dataset.from === hi || p.dataset.to === hi || (set.has(p.dataset.from) && set.has(p.dataset.to))));
    // highlight if both ends in neighbor set AND at least one is the active node
    const a = p.dataset.from, b = p.dataset.to;
    const lit = set && set.has(a) && set.has(b) && (a === hi || b === hi);
    p.classList.toggle('lit', !!lit);
    p.classList.toggle('dim', !!set && !lit);
  });
  Object.entries(nodeEls).forEach(([id, el]) => {
    el.classList.toggle('on', id === hi);
    el.classList.toggle('dim', !!set && !set.has(id));
  });
  reset.hidden = !focus;
}

function showTip(n, clientX, clientY) {
  tip.hidden = false;
  tip.innerHTML = `<b>${n.label}</b><span class="g">${n.group}</span><p>${n.blurb}</p>${n.href ? '<em>点击进入教程 →</em>' : '<em>暂无独立教程</em>'}`;
  const br = board.getBoundingClientRect();
  let x = clientX - br.left + 16, y = clientY - br.top + 16;
  tip.style.left = Math.min(x, br.width - tip.offsetWidth - 12) + 'px';
  tip.style.top = Math.min(y, br.height - tip.offsetHeight - 12) + 'px';
}
function hideTip() { tip.hidden = true; }

function setFocus(id) {
  focus = id;
  const n = byId[id];
  // 把焦点节点平移到视野中心附近（缩放画板）
  if (id === 'ai' || !id) {
    svg.style.transform = '';
    focus = null;
  } else {
    const dx = 500 - n.x, dy = 500 - n.y;
    svg.style.transform = `translate(${dx * 0.45}px, ${dy * 0.45}px) scale(1.15)`;
  }
  paint();
}

Object.values(nodeEls).forEach(el => {
  const id = el.dataset.id;
  const n = byId[id];
  el.addEventListener('pointerenter', e => {
    hover = id; paint();
    showTip(n, e.clientX, e.clientY);
  });
  el.addEventListener('pointermove', e => showTip(n, e.clientX, e.clientY));
  el.addEventListener('pointerleave', () => { hover = null; paint(); hideTip(); });
  el.addEventListener('click', e => {
    e.stopPropagation();
    if (n.href && focus === id) { location.href = n.href; return; }
    if (n.href && !matchMedia('(pointer: fine)').matches) {
      // 移动端：第一次聚焦，第二次进入
      if (focus === id) location.href = n.href;
      else setFocus(id);
      return;
    }
    if (n.kind === 'hub') { setFocus(null); return; }
    setFocus(id);
  });
  el.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); }
  });
});

board.addEventListener('click', () => { if (focus) setFocus(null); });
reset.addEventListener('click', e => { e.stopPropagation(); setFocus(null); });

// 入场：蛛丝画出
if (!reduce) {
  requestAnimationFrame(() => {
    edgeEls.forEach((p, i) => {
      p.style.transition = `stroke-dashoffset .9s cubic-bezier(.22,1,.36,1) ${0.04 * i}s`;
      p.style.strokeDashoffset = '0';
    });
    svg.classList.add('drawn');
  });
} else {
  svg.classList.add('drawn');
}
</script>

<style>
.head{max-width:820px;padding-top:48px}
.kicker{font-size:13px;color:var(--ink-3);margin:0 0 12px}
h1{font-family:var(--serif);font-size:clamp(30px,4.6vw,46px);line-height:1.25;margin:0 0 14px}
.lead{font-size:18px;color:var(--ink-2);margin:0;max-width:40em}
.stage{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:36px;align-items:start;margin-top:36px;padding-bottom:40px}
.board{position:relative;background:#E2D6BC;background-image:radial-gradient(rgba(90,67,0,.12) 1px,transparent 1.4px);background-size:7px 7px;
  border-radius:var(--r);border:1.5px solid var(--ink);box-shadow:6px 6px 0 var(--pin);overflow:hidden;aspect-ratio:1/1;touch-action:manipulation}
.web{width:100%;height:100%;display:block;transform-origin:50% 50%;transition:transform .7s var(--flow)}
.scaffold .ring{fill:none;stroke:rgba(23,21,15,.18);stroke-width:1}
.scaffold .spoke{stroke:rgba(23,21,15,.14);stroke-width:1}
:global(.silk){fill:none;stroke:#17150F;stroke-width:1.6;opacity:.55;transition:stroke .25s,opacity .25s,stroke-width .25s}
:global(.silk.lit){stroke:var(--string,#B8322A);stroke-width:2.6;opacity:1}
:global(.silk.dim){opacity:.08}
:global(.node){cursor:pointer;outline:none;transition:opacity .25s}
:global(.node .lab){font-family:var(--sans);font-size:13px;fill:#17150F;font-weight:600;pointer-events:none}
:global(.node .lab.hub){font-family:var(--serif);font-size:22px;font-weight:900}
:global(.node.kind-concept .lab){font-size:12px;font-weight:500;fill:#4A463C}
:global(.node.on .body){filter:url(#soft)}
:global(.node.dim){opacity:.22}
:global(.node.kind-lesson .body){transition:transform .4s var(--spring)}
:global(.drawn .node){animation:pop .55s var(--spring) both;animation-delay:calc(var(--i) * 30ms)}
@keyframes pop{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
:global(.node.kind-lesson:not(.dim) .body){animation:float 4.5s ease-in-out infinite;animation-delay:calc(var(--i) * 120ms)}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.tip{position:absolute;z-index:5;min-width:180px;max-width:240px;background:#FFFDF6;border:1.5px solid var(--ink);border-radius:var(--r);
  padding:12px 14px;box-shadow:4px 4px 0 var(--pin);pointer-events:none;font-size:14px;line-height:1.5}
.tip b{font-family:var(--serif);font-size:16px;display:block}
.tip .g{font:11px var(--mono);color:var(--ink-3)} .tip p{margin:6px 0 4px;color:var(--ink-2)} .tip em{font-style:normal;color:#A8740A;font-size:12.5px}
.reset{position:absolute;right:12px;top:12px;z-index:4;font:12px var(--mono);border:1.5px solid var(--ink);background:#FFFDF6;
  border-radius:99px;padding:6px 12px;cursor:pointer;box-shadow:2px 2px 0 var(--pin)}
.reset:hover{background:var(--pin)}
.side h2{font-family:var(--serif);font-size:20px;margin:0 0 10px}
.side ol{margin:0 0 28px;padding-left:1.2em;color:var(--ink-2);font-size:15px;line-height:1.7}
.side li{margin-bottom:6px}
.legend{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:10px}
.legend li{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--ink-2)}
.legend i{width:12px;height:12px;border-radius:50%;margin-top:4px;flex:none;border:1.5px solid var(--ink)}
.legend b{display:block;color:var(--ink);font-size:13px}
.note{font-size:12px;color:var(--ink-3);margin:0 0 16px}
@media(max-width:900px){
  .stage{grid-template-columns:1fr;gap:24px}
  .side{order:2} .board{order:1}
}
@media(prefers-reduced-motion:reduce){
  :global(.drawn .node),:global(.node.kind-lesson .body){animation:none!important}
  .web{transition:none}
}
</style>
