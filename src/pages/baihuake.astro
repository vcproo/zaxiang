---
import { u } from '../url';
import Base from '../layouts/Base.astro';
import { allTutorials } from '../lib';
const s = (await allTutorials()).filter(t => t.data.series === 'AI 白话课').sort((a, b) => a.data.order! - b.data.order!);
const groups = [...new Set(s.map(t => t.data.tags[1]))].map((g, i) => ({ g, i, items: s.filter(t => t.data.tags[1] === g) }));
const cn = ['一', '二', '三', '四', '五', '六'];
---
<Base title="AI 白话课：十个热词，说人话" description="不讲公式，不堆术语。每篇讲一个词，配一个能点着玩的小演示，十来分钟读完。">
<section class="wrap series">
  <p class="mono k">SERIES · AI 白话课</p>
  <h1>十个 AI 热词，说人话</h1>
  <p class="lead">不讲公式，不堆术语。每篇讲一个词，配一个能点着玩的小演示，十来分钟读完。按顺序看最好，后面会用到前面的东西。</p>
  {groups.map(({ g, i, items }) => <>
    <h2 class="mono">{cn[i]} · {g}</h2>
    <ol>{items.map(t => <li><a class="row" href={u(`/tutorials/${t.id}/`)}><span class="no mono">{String(t.data.order).padStart(2, '0')}</span><span class="t">{t.data.title.split('：')[0]}<small>{t.data.title.split('：').slice(1).join('：')}</small></span><span class="go">→</span></a></li>)}</ol>
  </>)}
</section>
</Base>
<style>
.series{max-width:800px} .k{font-size:13px;color:var(--ink-3);margin:56px 0 12px}
h1{font-family:var(--serif);font-size:clamp(32px,5vw,48px);line-height:1.25;margin:0 0 16px} .lead{font-size:18px;color:var(--ink-2);margin:0 0 24px}
h2{font-size:13px;color:var(--ink-3);letter-spacing:.1em;margin:40px 0 4px;font-weight:400}
ol{list-style:none;padding:0;margin:0}
.row{display:flex;gap:18px;align-items:baseline;padding:18px 4px;border-bottom:1px solid var(--line);text-decoration:none;transition:background .25s}
.row:hover{background:rgba(242,194,48,.14)} .row:hover .go{transform:translateX(6px)}
.no{color:#A8740A;width:28px;flex:none} .t{font-family:var(--serif);font-size:21px;font-weight:700;flex:1}
.t small{display:block;font:15px var(--sans);color:var(--ink-3);margin-top:2px} .go{transition:transform .35s var(--spring)}
</style>
