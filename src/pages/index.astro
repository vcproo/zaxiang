---
import { u } from '../url';
import Base from '../layouts/Base.astro';
import IpFigure from '../components/IpFigure.astro';
import { SITE } from '../site';
import { allTutorials } from '../lib';
import { NODES, EDGES, GROUP_COLOR } from '../zhishi';
import { skills } from '../skills';
import { tips } from '../tips';
import { tools } from '../tools';

const all = await allTutorials();
const featured = (all.filter(t => t.data.featured).length ? all.filter(t => t.data.featured) : all).slice(0, 3);
const tags = [...new Set(all.flatMap(t => t.data.tags))];
const tagCount = (g: string) => all.filter(t => t.data.tags.includes(g)).length;
const lessons = NODES.filter(n => n.kind === 'lesson');

// 背景里的「线索词」：确定性的伪随机散布，手电筒照到才看得清
let seed = 7;
const rnd = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const clueWords = [...NODES.map(n => n.label), ...NODES.map(n => n.caseId), 'CONTEXT', 'PROMPT', 'EVIDENCE', '线索', '推理', '证物'];
const clues = clueWords.map((w, i) => ({
  w, x: (i % 6) * 16.5 + rnd() * 12, y: Math.floor(i / 6) * 16 + rnd() * 10 + 2,
  s: 12 + Math.round(rnd() * 12), r: Math.round((rnd() - .5) * 16),
}));

// 首页上浮着的三张证物签，直接通往对应教程
const evidence = ['prompt', 'agent', 'mcp'].map(id => NODES.find(n => n.id === id)!).filter(Boolean);

// 档案室里的迷你知识网（与 /zhishi/ 同一份数据）
const G = { w: 420, h: 320, cx: 210, cy: 160 };
const lessonPos = Object.fromEntries(lessons.map((n, i) => {
  const a = (i / lessons.length) * Math.PI * 2 - Math.PI / 2;
  return [n.id, { x: G.cx + Math.cos(a) * 92, y: G.cy + Math.sin(a) * 92, a }];
}));
const anchor: Record<string, string> = { prompteng: 'prompt', llm: 'token', multimodal: 'aigc', kb: 'rag', toolcall: 'agent', workflow: 'harness' };
const pos: Record<string, { x: number; y: number }> = { ai: { x: G.cx, y: G.cy }, ...lessonPos };
NODES.filter(n => n.kind === 'concept').forEach((c, i) => {
  const base = lessonPos[anchor[c.id]]?.a ?? i;
  pos[c.id] = { x: G.cx + Math.cos(base + .22) * 140, y: G.cy + Math.sin(base + .22) * 128 };
});
const miniEdges = EDGES.filter(e => pos[e.from] && pos[e.to]);
const miniNodes = NODES.filter(n => pos[n.id]);
const caseNo = (o?: number) => `CASE-${String(o ?? 0).padStart(3, '0')}`;
---
<Base>
<section class="hero" data-hero>
  <div class="clues" aria-hidden="true">{clues.map(c => <span style={`left:${c.x}%;top:${c.y}%;font-size:${c.s}px;rotate:${c.r}deg`}>{c.w}</span>)}</div>
  <div class="clues lit" aria-hidden="true">{clues.map(c => <span style={`left:${c.x}%;top:${c.y}%;font-size:${c.s}px;rotate:${c.r}deg`}>{c.w}</span>)}</div>
  <div class="torch" aria-hidden="true"></div>

  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="eyebrow live rise">CASE FILE · AI ／ 调查进行中</p>
      <h1 class="hero-h rise" style="animation-delay:.08s">我是蜘蛛侦探，<br/><span id="tw">专门调查 <em class="hl">AI</em> 的人。</span><span class="caret" aria-hidden="true"></span></h1>
      <p class="hero-lead rise" style="animation-delay:.16s">{SITE.tagline}这里收录我写过的 AI 教程与工具笔记：从提示词到 Agent，从本地模型到工作流，每一篇都能照着做出结果。</p>
      <div class="hero-cta rise" style="animation-delay:.24s">
        <a class="sd-btn" href={u("/tutorials/")}>开始读教程 <span class="arr">→</span></a>
        <a class="sd-btn ghost" href={u("/about/")}>认识我</a>
      </div>
      <ul class="hero-social rise" style="animation-delay:.32s">{SITE.socials.map(s => <li><a href={s.url}>{s.name}</a></li>)}</ul>
    </div>
    <div class="hero-stage rise" style="animation-delay:.12s">
      <IpFigure variant="hero" src="/ip/character-hero.webp" alt="蜘蛛侦探：持放大镜与笔记本" width={540} height={707} caption="IP · SPIDER DETECTIVE" />
      {evidence.map((n, i) => (
        <a class={`ev ev${i}`} href={u(n.href!)}><i aria-hidden="true"></i><span class="mono">{n.caseId}</span><b>{n.label}</b></a>
      ))}
    </div>
  </div>

  <div class="wrap stats">
    <div><b>{all.length}</b><span class="mono">篇教程</span></div>
    <div><b>{NODES.length}</b><span class="mono">个知识节点</span></div>
    <div><b>17</b><span class="mono">种画风</span></div>
    <div><b>34</b><span class="mono">个动效</span></div>
  </div>
</section>

<div class="ticker" aria-label="十个 AI 热词">
  <div class="ticker-track">
    {[0, 1].map(k => lessons.map(n => (
      <a href={u(n.href!)} tabindex={k ? -1 : undefined} aria-hidden={k ? 'true' : undefined}><span class="mono">{n.caseId}</span>{n.label}</a>
    )))}
  </div>
</div>

<section class="wrap block">
  <div class="sec-head reveal">
    <div><p class="eyebrow">Start here</p><h2>从这里开始</h2></div>
    <a href={u("/tutorials/")} class="more">全部 {all.length} 篇 →</a>
  </div>
  <div class="cases">
    {featured.map((t, i) => (
      <a class="case sd-card spot reveal" style={`--d:${i * .08}s`} href={u(`/tutorials/${t.id}/`)}>
        <span class="case-no mono" aria-hidden="true">{String(t.data.order ?? i + 1).padStart(2, '0')}</span>
        <span class="case-tab mono">{caseNo(t.data.order ?? i + 1)} · {t.data.level}</span>
        <h3>{t.data.title}</h3>
        <p>{t.data.description}</p>
        <span class="case-foot"><span class="mono">{t.data.kicker ?? t.data.tags.at(-1)}</span><span class="go">阅读 <span>→</span></span></span>
      </a>
    ))}
  </div>
</section>

<section class="wrap block">
  <div class="sec-head reveal"><div><p class="eyebrow">Archive room</p><h2>档案室</h2></div></div>
  <div class="bento">
    <a class="b b-net sd-card spot reveal" href={u("/zhishi/")}>
      <div class="b-copy">
        <p class="eyebrow">Graph · {NODES.length} nodes · {EDGES.length} edges</p>
        <h3>知识网络</h3>
        <p>侦办级知识图谱：把零散的 AI 线索连成可追踪的案情图。点选节点，沿邻域下钻至教程档案。</p>
        <span class="go mono">OPEN GRAPH →</span>
      </div>
      <svg class="mini" viewBox={`0 0 ${G.w} ${G.h}`} aria-hidden="true">
        <g class="mini-rot">
          <circle cx={G.cx} cy={G.cy} r="92" class="orbit"/><circle cx={G.cx} cy={G.cy} r="138" class="orbit"/>
          {miniEdges.map(e => <line x1={pos[e.from].x} y1={pos[e.from].y} x2={pos[e.to].x} y2={pos[e.to].y} class={e.from === 'ai' ? 'spoke' : 'link'}/>)}
          {miniNodes.map(n => <circle cx={pos[n.id].x} cy={pos[n.id].y} r={n.kind === 'hub' ? 9 : n.kind === 'lesson' ? 5 : 3.5} fill={n.kind === 'concept' ? '#141218' : GROUP_COLOR[n.group]} stroke={GROUP_COLOR[n.group]} class={n.kind}/>)}
        </g>
      </svg>
    </a>
    <a class="b sd-card spot reveal" style="--d:.06s" href={u("/motion/")}>
      <p class="eyebrow">Motion archive</p>
      <h3>动效档案</h3>
      <p>画风怎么叫，动效怎么动。看中哪个，把那句话交给你的 AI。</p>
      <span class="b-num"><b>17</b><small class="mono">画风</small><b>34</b><small class="mono">动效</small></span>
    </a>
    <a class="b sd-card spot reveal" style="--d:.12s" href={u("/skill/")}>
      <p class="eyebrow">Skill archive</p>
      <h3>Skill 档案</h3>
      <p>{skills[0] ? `最新收录：${skills[0].name}——${skills[0].category}。` : '收录用过的 Agent Skill。'}</p>
      <span class="b-num"><b>{skills.length}</b><small class="mono">个 Skill</small></span>
    </a>
    <a class="b sd-card spot reveal" style="--d:.06s" href={u("/tips/")}>
      <p class="eyebrow">Field notes</p>
      <h3>小技巧</h3>
      <p>{tips[0] ? tips[0].title : '一句话就能用上的 AI 小技巧。'}</p>
      <span class="b-num"><b>{tips.length}</b><small class="mono">条技巧</small></span>
    </a>
    <a class="b sd-card spot reveal" style="--d:.12s" href={u("/tools/")}>
      <p class="eyebrow">Toolkit</p>
      <h3>工具</h3>
      <p>{tools[0] ? tools[0].name : '顺手的工具，放在这里。'}</p>
      <span class="b-num"><b>{tools.length}</b><small class="mono">个工具</small></span>
    </a>
  </div>
</section>

<section class="wrap block">
  <div class="sec-head reveal"><div><p class="eyebrow">Open leads</p><h2>正在调查的线索</h2></div></div>
  <div class="tags reveal">{tags.map(t => <a class="sd-chip" href={u(`/tutorials/?tag=${encodeURIComponent(t)}`)}>#{t}<span class="n">{tagCount(t)}</span></a>)}</div>
</section>
</Base>

<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
// 打字机：逐字打出第二行
const tw = document.getElementById('tw')!;
if (!reduce) {
  const nodes = [...tw.childNodes].map(n => ({ n, text: n.textContent! }));
  nodes.forEach(o => o.n.textContent = '');
  let i = 0, k = 0;
  setTimeout(function step() { if (k >= nodes.length) return; const o = nodes[k]; o.n.textContent = o.text.slice(0, ++i);
    if (i >= o.text.length) { k++; i = 0; } setTimeout(step, 90 + Math.random() * 70); }, 700);
}
// 手电筒：指针照到哪里，哪里的线索词就亮起来
const hero = document.querySelector<HTMLElement>('[data-hero]')!;
if (!reduce && matchMedia('(pointer: fine)').matches) {
  let raf = 0, mx = 0, my = 0;
  hero.addEventListener('pointermove', e => {
    const r = hero.getBoundingClientRect(); mx = e.clientX - r.left; my = e.clientY - r.top;
    if (!raf) raf = requestAnimationFrame(() => { hero.style.setProperty('--mx', mx + 'px'); hero.style.setProperty('--my', my + 'px'); raf = 0; });
  }, { passive: true });
}
</script>

<style>
/* ---------- Hero ---------- */
.hero{--mx:72%;--my:38%;position:relative;overflow:hidden;margin-top:calc(var(--hdr) * -1);padding-top:calc(var(--hdr) + 48px)}
.clues{position:absolute;inset:0;pointer-events:none;user-select:none}
.clues span{position:absolute;font-family:var(--mono);font-weight:500;letter-spacing:.06em;white-space:nowrap;color:rgba(243,235,221,.045)}
.clues.lit{-webkit-mask-image:radial-gradient(circle 240px at var(--mx) var(--my),#000 0,transparent 72%);mask-image:radial-gradient(circle 240px at var(--mx) var(--my),#000 0,transparent 72%)}
.clues.lit span{color:rgba(199,239,220,.55)}
.torch{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle 420px at var(--mx) var(--my),rgba(199,239,220,.06),transparent 70%)}
@media(hover:none){.clues.lit,.torch{display:none}}
.hero-in{position:relative;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:40px;align-items:center;min-height:min(72vh,700px)}
.hero-copy{display:grid;gap:28px;justify-items:start}
.hero-h{margin:0;font-size:clamp(38px,4.7vw,68px);font-weight:800;line-height:1.12;letter-spacing:-.035em}
.hero-h em{font-style:normal;position:relative}
.hero-h em::after{content:"";position:absolute;left:-2%;right:-2%;bottom:.04em;height:.12em;border-radius:99px;background:var(--mint);opacity:.35}
.hero-lead{margin:0;font-size:18px;color:var(--fg-2);max-width:32em}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-social{list-style:none;padding:0;margin:4px 0 0;display:flex;gap:20px;flex-wrap:wrap;font-size:14px}
.hero-social a{color:var(--fg-3);text-decoration:none;transition:color .2s}
.hero-social a:hover{color:var(--mint)}
.hero-stage{position:relative;width:min(100%,500px);justify-self:center}
.ev{position:absolute;z-index:2;display:flex;align-items:center;gap:9px;padding:9px 14px 9px 10px;border-radius:999px;text-decoration:none;
  background:rgba(27,24,33,.82);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--line-2);font-size:14px;
  box-shadow:0 14px 30px -12px rgba(0,0,0,.6);animation:float 6s ease-in-out infinite;transition:border-color .25s,background .25s}
.ev i{width:8px;height:8px;border-radius:2px;background:var(--red);rotate:45deg}
.ev span{font-size:11px;color:var(--fg-3);letter-spacing:.08em}
.ev:hover{border-color:var(--mint);background:rgba(39,35,45,.95)}
.ev0{left:-6%;top:22%}
.ev1{right:-8%;top:46%;animation-delay:-2s}
.ev2{left:2%;bottom:12%;animation-delay:-4s}
@keyframes float{50%{transform:translateY(-8px)}}
.stats{position:relative;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);margin-top:24px}
.stats div{display:flex;align-items:baseline;gap:12px;padding:26px 0 30px}
.stats div:not(:first-child){padding-left:28px;border-left:1px solid var(--line)}
.stats b{font-size:clamp(30px,3.6vw,44px);font-weight:700;letter-spacing:-.03em;line-height:1;font-variant-numeric:tabular-nums}
.stats span{font-size:13px;letter-spacing:.1em;color:var(--fg-3)}

/* ---------- 跑马灯 ---------- */
.ticker{overflow:hidden;border-block:1px solid var(--line);padding:22px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.ticker-track{display:flex;width:max-content;animation:tick 48s linear infinite}
.ticker:hover .ticker-track{animation-play-state:paused}
.ticker a{display:flex;align-items:baseline;gap:12px;padding:0 34px;text-decoration:none;white-space:nowrap;font-size:clamp(28px,4vw,48px);font-weight:800;letter-spacing:-.02em;
  color:rgba(243,235,221,.16);transition:color .3s}
.ticker a span{font-size:12px;font-weight:500;color:var(--fg-3);letter-spacing:.1em}
.ticker a::after{content:"✦";margin-left:34px;font-size:.4em;color:var(--mint);opacity:.6;align-self:center}
.ticker a:hover{color:var(--mint)}
@keyframes tick{to{transform:translateX(-50%)}}

.block{margin-top:120px}

/* ---------- 精选案卷 ---------- */
.cases{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.case{display:flex;flex-direction:column;gap:14px;padding:30px 28px 26px;min-height:340px}
.case-no{position:absolute;right:18px;top:6px;font-size:96px;font-weight:700;line-height:1;color:transparent;-webkit-text-stroke:1px rgba(243,235,221,.09);transition:-webkit-text-stroke-color .4s}
.case:hover .case-no{-webkit-text-stroke-color:rgba(199,239,220,.4)}
.case-tab{font-size:11.5px;letter-spacing:.12em;color:var(--mint)}
.case h3{margin:8px 0 0;font-size:23px;line-height:1.4;font-weight:700;letter-spacing:-.01em;max-width:13em}
.case p{margin:0;color:var(--fg-2);font-size:15px;line-height:1.75}
.case-foot{margin-top:auto;padding-top:18px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--fg-3)}
.case-foot .mono{font-size:11px;letter-spacing:.12em}
.go{color:var(--fg)} .go span{display:inline-block;transition:transform .35s var(--spring)}
.case:hover .go span{transform:translateX(5px)}

/* ---------- 档案室 bento ---------- */
.bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(250px,auto);gap:20px}
.b{display:flex;flex-direction:column;gap:10px;padding:28px}
.b h3{margin:4px 0 0;font-size:24px;font-weight:800;letter-spacing:-.01em}
.b p:not(.eyebrow){margin:0;color:var(--fg-2);font-size:14.5px;line-height:1.7}
.b-num{margin-top:auto;display:flex;align-items:baseline;gap:8px;padding-top:16px}
.b-num b{font-size:46px;font-weight:700;line-height:1;letter-spacing:-.04em;color:var(--fg);transition:color .3s}
.b-num small{font-size:11px;letter-spacing:.1em;color:var(--fg-3);margin-right:10px}
.b:hover .b-num b{color:var(--mint)}
.b-net{grid-column:span 2;grid-row:span 2;padding:32px;background:radial-gradient(circle at 70% 70%,rgba(199,239,220,.06),transparent 60%),var(--bg-2)}
.b-net .b-copy{display:grid;gap:10px;max-width:26em;position:relative;z-index:1}
.b-net h3{font-size:32px}
.b-net .go{font-size:12px;letter-spacing:.12em;color:var(--mint);margin-top:6px}
.mini{position:absolute;right:-6%;bottom:-10%;width:92%;height:auto;opacity:.95}
.mini-rot{transform-origin:210px 160px;animation:spin 140s linear infinite}
.b-net:hover .mini-rot{animation-duration:40s}
@keyframes spin{to{transform:rotate(360deg)}}
.orbit{fill:none;stroke:rgba(243,235,221,.06)}
.spoke{stroke:rgba(243,235,221,.1);stroke-width:1}
.link{stroke:rgba(243,235,221,.2);stroke-width:1}
.mini circle.lesson,.mini circle.hub{stroke-width:1.5}
.mini circle.concept{stroke-dasharray:2 2}

.tags{display:flex;flex-wrap:wrap;gap:10px}
.tags .n{opacity:.5;margin-left:2px}

@media(max-width:1060px){
  .bento{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cases{grid-template-columns:1fr 1fr}.cases .case:last-child{grid-column:span 2;min-height:0}
}
@media(max-width:860px){
  .hero-in{grid-template-columns:1fr;min-height:0;gap:8px}
  .hero-stage{order:-1;width:min(80%,380px)}
  .ev{font-size:13px;padding:7px 12px 7px 9px}
  .ev0{left:-10%}.ev1{right:-12%}
  .stats{grid-template-columns:1fr 1fr}
  .stats div:nth-child(odd){padding-left:0;border-left:0}
  .stats div:nth-child(n+3){border-top:1px solid var(--line)}
  .block{margin-top:88px}
}
@media(max-width:640px){
  .hero{padding-top:calc(var(--hdr) + 20px)}
  .cases{grid-template-columns:1fr}.cases .case:last-child{grid-column:auto}
  .case{min-height:0}
  .bento{grid-template-columns:1fr}
  .b-net{grid-column:auto;grid-row:auto;min-height:440px}
  .mini{width:110%;right:-14%}
  .stats div:nth-child(even){padding-left:18px}
}
</style>
