---
import { u } from '../url';
import '../styles/global.css';
import { SITE } from '../site';
const { title, description = SITE.tagline } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [['/', '首页'], ['/tutorials/', '教程'], ['/baihuake/', '白话课'], ['/zhishi/', '知识网'], ['/motion/', '动效'], ['/tools/', '工具'], ['/about/', '关于']];
---
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title ? `${title} · ${SITE.name}` : `${SITE.name} · AI 教程与笔记`}</title>
<meta name="description" content={description}/><link rel="icon" href={u("/favicon.svg")} type="image/svg+xml"/>
<link rel="icon" href={u("/favicon-32.png")} type="image/png" sizes="32x32"/>
<link rel="apple-touch-icon" href={u("/ip/avatar-256.png")}/></head>
<body>
<header class="top"><div class="wrap sd-bar">
  <a href={u("/")} class="logo"><img class="logo-img" src={u("/ip/avatar-64.png")} width="32" height="32" alt=""/>蜘蛛侦探</a>
  <nav>{nav.map(([h, l]) => <a href={u(h)} class={(h === '/' ? path === '/' : path.startsWith(h)) ? 'cur' : ''}>{l}</a>)}</nav>
</div></header>
<main><slot/></main>
<div class="dangle" aria-hidden="true"><div class="silk"></div><svg class="bug" width="30" height="30" viewBox="0 0 30 30"><g stroke="#17150F" stroke-width="1.6" fill="none" stroke-linecap="round"><path d="M10 12 3 6M10 15 2 14M10 18 3 23M11 20 6 28M20 12 27 6M20 15 28 14M20 18 27 23M19 20 24 28"/></g><ellipse cx="15" cy="17" rx="6" ry="7" fill="#17150F"/><circle cx="15" cy="9.5" r="3.6" fill="#17150F"/><circle cx="13.6" cy="9" r=".9" fill="#F2C230"/><circle cx="16.4" cy="9" r=".9" fill="#F2C230"/></svg></div>
<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
// 吊着的小蜘蛛：随滚动往下放丝
const dg = document.querySelector('.dangle') as HTMLElement;
let ticking = false;
const setLen = () => { const h = document.documentElement; const p = h.scrollTop / Math.max(1, h.scrollHeight - innerHeight);
  dg.style.setProperty('--len', (72 + p * (innerHeight * .5)) + 'px'); ticking = false; };
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(setLen); } }, { passive: true }); setLen();
// 彩蛋：输入 spider / 蜘蛛侦探，或连点蜘蛛 5 次
function toast(t: string) { const d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.append(d); setTimeout(() => d.remove(), 3200); }
function egg() {
  toast('🕷 你发现了一条隐藏线索：真相只有一个——多读几篇教程。');
  if (reduce) return;
  for (let i = 0; i < 18; i++) { const s = dg.querySelector('svg')!.cloneNode(true) as SVGElement; s.classList.add('rain');
    s.style.left = Math.random() * 100 + 'vw'; s.style.animationDuration = 2 + Math.random() * 2 + 's'; s.style.setProperty('--r', (Math.random() * 720 - 360) + 'deg');
    document.body.append(s); setTimeout(() => s.remove(), 4200); }
}
let buf = ''; addEventListener('keydown', e => { if ((e.target as HTMLElement).matches('input,textarea')) return; buf = (buf + e.key.toLowerCase()).slice(-6); if (buf === 'spider') egg(); });
let clicks = 0, t0 = 0; dg.querySelector('.bug')!.addEventListener('click', () => { const n = Date.now(); clicks = n - t0 < 600 ? clicks + 1 : 1; t0 = n; if (clicks >= 5) { clicks = 0; egg(); } });
console.log('%c🕷 蜘蛛侦探在此。线索：在页面上敲下 spider。', 'font-size:14px;background:#F2C230;color:#17150F;padding:4px 8px');
// 放大镜：悬停教程条目时出现（仅精确指针设备）
if (!reduce && matchMedia('(pointer: fine)').matches) {
  const lens = document.createElement('div'); lens.className = 'lens'; document.body.append(lens);
  let x = 0, y = 0, raf = 0;
  addEventListener('pointermove', e => { x = e.clientX; y = e.clientY; const on = !!(e.target as HTMLElement).closest('.row,.clue'); lens.classList.toggle('on', on);
    document.body.style.cursor = ''; if (!raf) raf = requestAnimationFrame(() => { lens.style.left = x + 'px'; lens.style.top = y + 'px'; raf = 0; }); }, { passive: true });
}
</script>
<footer><div class="wrap foot">
  <span>© {new Date().getFullYear()} 蜘蛛侦探 · Spider Detective</span>
  <span class="links">{SITE.socials.map(s => <a href={s.url}>{s.name}</a>)}</span>
</div></footer>
<style>
.top{position:sticky;top:0;z-index:10;background:rgba(243,239,230,.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.sd-bar{display:flex;justify-content:space-between;align-items:center;height:60px}
.logo{font-weight:800;text-decoration:none;display:flex;align-items:center;gap:10px;font-size:18px}
.logo-img{width:32px;height:32px;border-radius:50%;border:1.5px solid var(--ink);background:#F3EBDD;object-fit:cover;flex:none;transition:transform .3s var(--spring),box-shadow .25s}
.logo:hover .logo-img{transform:scale(1.06);box-shadow:2px 2px 0 var(--pin)}
.dot{display:none}
.dot{width:12px;height:12px;border-radius:50%;background:var(--pin);box-shadow:0 0 0 2px var(--ink)}
nav{display:flex;gap:4px} nav a{white-space:nowrap} nav a{text-decoration:none;padding:6px 12px;border-radius:var(--r);color:var(--ink-2);font-size:15px}
nav a:hover{color:var(--ink);background:rgba(242,194,48,.15)}
nav a.cur{color:var(--ink);background:var(--paper-2);font-weight:600}
footer{border-top:1px solid var(--line);margin-top:96px;padding:28px 0;color:var(--ink-3);font-size:14px}
.foot{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}
.links{display:flex;gap:16px;flex-wrap:wrap} .links a{text-decoration:none} .links a:hover{color:var(--ink)}
@media(max-width:720px){.sd-bar{height:auto;min-height:60px;flex-wrap:wrap;padding-top:12px;padding-bottom:10px;gap:10px}.logo{white-space:nowrap}nav{width:100%;overflow-x:auto;padding-bottom:3px}nav a{flex:none;padding:6px 10px}}
</style></body></html>
