---
import { u } from '../url';
import '../styles/global.css';
import { siteFor } from '../site';
import { ui, langFromPath, barePath, switchPath, type Lang } from '../i18n';
const lang = (Astro.props.lang as Lang | undefined) ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
const SITE = siteFor(lang);
const { title, description = SITE.tagline } = Astro.props;
const path = barePath(Astro.url.pathname);
const nav = t.nav;
const eyes = [[4, 4], [10, 6.5], [16, 9], [30, 9], [36, 6.5], [42, 4]];
const zhHref = switchPath(Astro.url.pathname, 'zh');
const enHref = switchPath(Astro.url.pathname, 'en');
const abs = (p: string) => Astro.site ? new URL(p, Astro.site).href : p;
---
<html lang={t.htmlLang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<script is:inline define:vars={{ siteBase: import.meta.env.BASE_URL }}>
(function () {
  var base = String(siteBase || '/').replace(/\/$/, '');
  var CHOICE = 'sd-lang';
  var GEO = 'sd-geo';
  var ZH = { CN: 1, HK: 1, MO: 1, TW: 1 };
  function bare(path) {
    if (path.indexOf(base) === 0) path = path.slice(base.length) || '/';
    if (!path || path.charAt(0) !== '/') path = '/' + (path || '');
    return path;
  }
  function current() {
    var path = bare(location.pathname);
    return path === '/en' || path.indexOf('/en/') === 0 ? 'en' : 'zh';
  }
  function dest(want) {
    if (want !== 'zh' && want !== 'en') return '';
    if (current() === want) return '';
    var path = bare(location.pathname);
    if (path === '/en' || path === '/en/') path = '/';
    else if (path.indexOf('/en/') === 0) path = path.slice(3) || '/';
    if (path.length > 1 && path.charAt(path.length - 1) !== '/') path += '/';
    var next = want === 'zh' ? base + (path === '/' ? '/' : path) : base + (path === '/' ? '/en/' : '/en' + path);
    return next + location.search + location.hash;
  }
  function go(want) {
    var href = dest(want);
    if (href) location.replace(href);
  }
  function remember(key, value) {
    try { (key === CHOICE ? localStorage : sessionStorage).setItem(key, value); } catch (e) {}
  }
  function read(key) {
    try { return (key === CHOICE ? localStorage : sessionStorage).getItem(key) || ''; } catch (e) { return ''; }
  }
  var choice = read(CHOICE);
  if (choice === 'zh' || choice === 'en') { go(choice); return; }
  var cached = read(GEO);
  if (cached === 'zh' || cached === 'en') { go(cached); return; }
  var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
  var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 4000);
  var opt = { credentials: 'omit' };
  if (ctrl) opt.signal = ctrl.signal;
  fetch('https://get.geojs.io/v1/ip/country.json', opt)
    .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
    .then(function (data) { return String((data && data.country) || '').toUpperCase(); })
    .catch(function () {
      return fetch('https://ipapi.co/country_code/', opt).then(function (r) { return r.ok ? r.text() : ''; });
    })
    .then(function (code) {
      clearTimeout(timer);
      code = String(code || '').trim().toUpperCase();
      if (!/^[A-Z]{2}$/.test(code)) return;
      var want = ZH[code] ? 'zh' : 'en';
      remember(GEO, want);
      go(want);
    })
    .catch(function () { clearTimeout(timer); });
})();
</script>
<title>{title ? `${title} · ${SITE.name}` : `${SITE.name} · ${t.docTitle}`}</title>
<meta name="description" content={description}/><meta name="theme-color" content="#141218"/>
<link rel="alternate" hreflang="zh-CN" href={abs(zhHref)}/>
<link rel="alternate" hreflang="en" href={abs(enHref)}/>
<link rel="alternate" hreflang="x-default" href={abs(zhHref)}/>
<link rel="icon" href={u("/favicon.svg")} type="image/svg+xml"/>
<link rel="icon" href={u("/favicon-32.png")} type="image/png" sizes="32x32"/>
<link rel="apple-touch-icon" href={u("/ip/avatar-256.png")}/></head>
<body data-egg={t.egg} data-console={t.console}>
<header class="hdr">
  <div class="wrap hdr-in">
    <a href={u("/", lang)} class="brand" title={t.backHome} aria-label={t.brandHome}>
      <span class="brand-ava"><img src={u("/ip/avatar-64.png")} width="34" height="34" alt=""/></span>
      <span class="brand-txt"><b>{SITE.name}</b><small class="mono">SPIDER DETECTIVE</small></span>
    </a>
    <nav class="nav" aria-label={t.navLabel}>
      {nav.map(([h, l]) => <a href={u(h, lang)} class={path.startsWith(h) ? 'cur' : ''} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a>)}
    </nav>
    <nav class="lang" aria-label="Language">
      <a href={zhHref} hreflang="zh-CN" lang="zh-CN" data-lang-link class={lang === 'zh' ? 'on' : ''}>中文</a>
      <a href={enHref} hreflang="en" lang="en" data-lang-link class={lang === 'en' ? 'on' : ''}>EN</a>
    </nav>
    <button type="button" class="sense" aria-label={t.progress} title={t.progress}>
      <svg viewBox="0 0 46 13" width="46" height="13" aria-hidden="true">{eyes.map(([x, y]) => <circle cx={x} cy={y} r="2.3"/>)}</svg>
    </button>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mnav"><span></span><span></span><b class="sr">{t.menu}</b></button>
  </div>
  <div class="hdr-prog" aria-hidden="true"><i></i></div>
</header>
<div class="mnav" id="mnav" hidden>
  <nav class="wrap" aria-label={t.mobileNav}>
    <a href={u("/", lang)} class={path === '/' ? 'cur' : ''}><span class="mono">00</span>{t.homeMobile}</a>
    {nav.map(([h, l], i) => <a href={u(h, lang)} class={path.startsWith(h) ? 'cur' : ''}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{l}</a>)}
  </nav>
</div>
<main><slot/></main>
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-top">
      <p class="ftr-line">{t.tagA}<br/><span class="hl">{t.tagB}</span></p>
      <div class="ftr-cols">
        <div><p class="eyebrow">{t.footerOnSite}</p>{nav.map(([h, l]) => <a href={u(h, lang)}>{l}</a>)}</div>
        <div><p class="eyebrow">{t.footerFind}</p>{SITE.socials.map(s => <a href={s.url}>{s.name}</a>)}</div>
      </div>
    </div>
    <div class="ftr-bot mono">
      <a href={u("/", lang)} class="ftr-brand"><img src={u("/ip/avatar-64.png")} width="22" height="22" alt=""/>© {new Date().getFullYear()} {t.footerCopy}</a>
      <span>END OF FILE ■</span>
    </div>
  </div>
</footer>
<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const root = document.documentElement;

// 阅读进度：顶部细线 + 六颗副眼依次亮起
const dots = [...document.querySelectorAll<SVGCircleElement>('.sense circle')];
const bar = document.querySelector<HTMLElement>('.hdr-prog i')!;
const hdr = document.querySelector<HTMLElement>('.hdr')!;
let ticking = false;
function progress() {
  const max = root.scrollHeight - innerHeight;
  const p = max > 40 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
  bar.style.transform = `scaleX(${p})`;
  const lit = Math.round(p * dots.length);
  dots.forEach((d, i) => d.classList.toggle('on', i < lit));
  hdr.classList.toggle('scrolled', scrollY > 8);
  ticking = false;
}
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(progress); } }, { passive: true });
addEventListener('resize', progress, { passive: true });
progress();

// 移动端菜单
const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
const mnav = document.getElementById('mnav')!;
function setMenu(open: boolean) {
  mnav.hidden = !open; menuBtn.setAttribute('aria-expanded', String(open));
  document.body.classList.toggle('menu-open', open);
}
menuBtn.addEventListener('click', () => setMenu(mnav.hidden));
mnav.addEventListener('click', e => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
addEventListener('keydown', e => { if (e.key === 'Escape' && !mnav.hidden) setMenu(false); });
matchMedia('(min-width: 961px)').addEventListener('change', e => { if (e.matches) setMenu(false); });

// 进场：带 .reveal 的元素滚到视口时浮现
const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
document.querySelectorAll('.reveal').forEach(el => reduce ? el.classList.add('in') : io.observe(el));

// 卡片手电筒：记录指针在卡片内的位置
addEventListener('pointermove', e => {
  const el = (e.target as HTMLElement).closest?.('.spot') as HTMLElement | null;
  if (!el) return;
  const r = el.getBoundingClientRect();
  el.style.setProperty('--x', `${e.clientX - r.left}px`); el.style.setProperty('--y', `${e.clientY - r.top}px`);
}, { passive: true });

// 彩蛋：敲 spider，或连点副眼 5 次
function toast(t: string) { const d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.append(d); setTimeout(() => d.remove(), 3400); }
function egg() {
  toast(document.body.dataset.egg || '');
  if (reduce) return;
  const s = document.createElement('div'); s.className = 'scan'; document.body.append(s); setTimeout(() => s.remove(), 1700);
  dots.forEach((d, i) => { d.classList.remove('flash'); setTimeout(() => d.classList.add('flash'), i * 70); setTimeout(() => d.classList.remove('flash'), 900 + i * 70); });
}
let buf = '';
addEventListener('keydown', e => { if ((e.target as HTMLElement).matches('input,textarea')) return; buf = (buf + e.key.toLowerCase()).slice(-6); if (buf === 'spider') egg(); });
let clicks = 0, t0 = 0;
document.querySelector('.sense')!.addEventListener('click', () => { const n = Date.now(); clicks = n - t0 < 600 ? clicks + 1 : 1; t0 = n; if (clicks >= 5) { clicks = 0; egg(); } });
console.log('%c' + (document.body.dataset.console || ''), 'font-size:14px;background:#C7EFDC;color:#27232D;padding:4px 8px;border-radius:4px');
document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach(a => {
  const url = new URL(a.href, location.origin);
  url.search = location.search;
  url.hash = location.hash;
  a.href = url.pathname + url.search + url.hash;
  a.addEventListener('click', () => {
    try { localStorage.setItem('sd-lang', a.hreflang === 'en' ? 'en' : 'zh'); } catch { /* 隐私模式忽略 */ }
  });
});
</script>
<style>
.hdr{position:sticky;top:0;z-index:40;transition:background .3s,border-color .3s;border-bottom:1px solid transparent}
.hdr.scrolled,body.menu-open .hdr{background:rgba(20,18,24,.78);backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);border-bottom-color:var(--line)}
.hdr-in{display:flex;align-items:center;gap:28px;height:var(--hdr)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;margin-right:auto}
.brand-ava{width:38px;height:38px;border-radius:50%;background:var(--cream);display:grid;place-items:center;flex:none;
  box-shadow:0 0 0 1px rgba(243,235,221,.2),0 0 0 5px rgba(199,239,220,0);transition:box-shadow .35s,transform .45s var(--spring)}
.brand-ava img{width:34px;height:34px;border-radius:50%}
.brand:hover .brand-ava{transform:rotate(-8deg) scale(1.06);box-shadow:0 0 0 1px rgba(243,235,221,.3),0 0 0 5px var(--mint-glow)}
.brand-txt{display:grid;line-height:1.15}
.brand-txt b{font-size:16.5px;font-weight:800;letter-spacing:.02em}
.brand-txt small{font-size:9.5px;letter-spacing:.22em;color:var(--fg-3)}
.nav{display:flex;gap:2px}
.nav a{position:relative;padding:8px 13px;border-radius:999px;text-decoration:none;font-size:14.5px;color:var(--fg-2);white-space:nowrap;transition:color .2s,background .2s}
.nav a:hover{color:var(--fg);background:rgba(243,235,221,.06)}
.nav a.cur{color:var(--mint)}
.nav a.cur::after{content:"";position:absolute;left:50%;bottom:1px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--mint)}
.lang{display:flex;align-items:center;gap:1px;padding:3px;border:1px solid var(--line-2);border-radius:999px;flex:none}
.lang a{padding:4px 8px;border-radius:999px;text-decoration:none;font:500 11px var(--mono);letter-spacing:.06em;color:var(--fg-3)}
.lang a.on{background:var(--mint);color:var(--ink)}
.lang a:hover{color:var(--fg)}
.lang a.on:hover{color:var(--ink)}
.sense{display:grid;place-items:center;width:62px;height:34px;border-radius:999px;border:1px solid var(--line-2);background:transparent;cursor:pointer;padding:0;transition:border-color .2s}
.sense:hover{border-color:var(--mint)}
.sense circle{fill:rgba(243,235,221,.18);transition:fill .35s,filter .35s}
.sense circle.on{fill:var(--mint);filter:drop-shadow(0 0 3px rgba(199,239,220,.8))}
.sense circle.flash{fill:var(--red)}
.hdr-prog{position:absolute;left:0;right:0;bottom:-1px;height:2px;pointer-events:none}
.hdr-prog i{display:block;height:100%;background:linear-gradient(90deg,transparent,var(--mint));transform-origin:left;transform:scaleX(0)}
.menu-btn{display:none;position:relative;width:42px;height:42px;border-radius:50%;border:1px solid var(--line-2);background:transparent;cursor:pointer}
.menu-btn span{position:absolute;left:12px;right:12px;height:1.5px;background:var(--fg);transition:transform .35s var(--spring),top .35s var(--spring)}
.menu-btn span:nth-child(1){top:16px} .menu-btn span:nth-child(2){top:24px}
.menu-btn[aria-expanded="true"] span:nth-child(1){top:20px;transform:rotate(45deg)}
.menu-btn[aria-expanded="true"] span:nth-child(2){top:20px;transform:rotate(-45deg)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.mnav{position:fixed;inset:var(--hdr) 0 0;z-index:39;background:rgba(20,18,24,.97);backdrop-filter:blur(14px);overflow-y:auto}
.mnav nav{display:grid;padding-top:20px;padding-bottom:40px}
.mnav a{display:flex;align-items:baseline;gap:18px;padding:16px 0;border-bottom:1px solid var(--line);text-decoration:none;font-size:28px;font-weight:800;letter-spacing:-.01em;
  animation:rise .5s var(--ease) both}
.mnav a span{font-size:12px;color:var(--fg-3);font-weight:400}
.mnav a.cur{color:var(--mint)}
.mnav a:nth-child(2){animation-delay:.03s}.mnav a:nth-child(3){animation-delay:.06s}.mnav a:nth-child(4){animation-delay:.09s}
.mnav a:nth-child(5){animation-delay:.12s}.mnav a:nth-child(6){animation-delay:.15s}.mnav a:nth-child(7){animation-delay:.18s}.mnav a:nth-child(8){animation-delay:.21s}
:global(body.menu-open){overflow:hidden}

.ftr{margin-top:140px;border-top:1px solid var(--line);background:linear-gradient(180deg,rgba(27,24,33,.6),transparent)}
.ftr-top{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:48px;padding:72px 0 56px}
.ftr-line{margin:0;font-size:clamp(26px,3.6vw,42px);font-weight:800;line-height:1.3;letter-spacing:-.02em}
.ftr-cols{display:grid;grid-template-columns:1fr 1fr;gap:32px}
.ftr-cols div{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
.ftr-cols .eyebrow{margin-bottom:6px}
.ftr-cols a{color:var(--fg-2);text-decoration:none;font-size:15px;transition:color .2s}
.ftr-cols a:hover{color:var(--mint)}
.ftr-bot{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:22px 0 28px;border-top:1px solid var(--line);font-size:12px;color:var(--fg-3)}
.ftr-brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none}
.ftr-brand img{border-radius:50%;background:var(--cream)}

@media(max-width:1060px){.nav a{padding:8px 10px;font-size:14px}.hdr-in{gap:16px}}
@media(max-width:960px){.nav{display:none}.menu-btn{display:block}.sense{width:56px}.lang a{padding:4px 7px}}
@media(max-width:720px){.ftr{margin-top:96px}.ftr-top{grid-template-columns:1fr;padding:56px 0 40px}.brand-txt small{display:none}}
</style></body></html>
